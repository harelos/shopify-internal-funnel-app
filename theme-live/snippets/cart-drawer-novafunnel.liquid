  function bundleSku(quantity,alloc){
    if(Number(alloc.mediumbrown||0)>0)return ['NOVASALE',quantity,alloc.black,alloc.darkbrown,alloc.mediumbrown,alloc.lightbrown,alloc.purple,alloc.red].join('-');
    return ['NOVASALE',quantity,alloc.black,alloc.darkbrown,alloc.lightbrown,alloc.purple,alloc.red].join('-');
  }
  function editorRoot(){return document.getElementById('novafunnelShadeEditor');}
  function ensureEditor(){
    var root=editorRoot();
    if(root)return root;
    document.body.insertAdjacentHTML('beforeend','<div id="novafunnelShadeEditor" role="dialog" aria-modal="true" aria-labelledby="novafunnelShadeEditorTitle" hidden><section class="novafunnel-shade-editor__panel"><header class="novafunnel-shade-editor__head"><h2 class="novafunnel-shade-editor__title" id="novafunnelShadeEditorTitle">עדכון הגוון בחבילה</h2><button class="novafunnel-shade-editor__close" type="button" data-novafunnel-editor-close aria-label="סגירת בחירת הגוון">×</button></header><div class="novafunnel-shade-editor__body"><p class="novafunnel-shade-editor__intro" id="novafunnelShadeEditorIntro"></p><div class="novafunnel-shade-editor__modes"><button class="novafunnel-shade-editor__mode" type="button" data-novafunnel-editor-mode="single">גוון אחד</button><button class="novafunnel-shade-editor__mode" type="button" data-novafunnel-editor-mode="mix">שילוב גוונים</button></div><div id="novafunnelShadeEditorContent"></div><p class="novafunnel-shade-editor__error" id="novafunnelShadeEditorError" aria-live="polite"></p><button class="novafunnel-shade-editor__save" id="novafunnelShadeEditorSave" type="button">שמירת הבחירה</button></div></section></div>');
    root=editorRoot();
    root.addEventListener('click',function(event){if(event.target===root)closeEditor();});
    root.addEventListener('click',handleEditorClick);
    document.addEventListener('keydown',function(event){if(event.key==='Escape'&&editorRoot()&&!editorRoot().hidden)closeEditor();});
    return root;
  }
  function parseAllocation(properties,quantity){
    var alloc=cloneAlloc(),raw=String(properties&&properties['בחירת גוונים']||'');
    raw.split(/\s*(?:\+|·)\s*/).forEach(function(part){
      var match=part.match(/(\d+)\s*[×x]\s*(.+)/);
      if(!match)return;
      var key=keys.find(function(candidate){return shadeName(candidate)===String(match[2]).trim();});
      if(key)alloc[key]=Number(match[1]);
