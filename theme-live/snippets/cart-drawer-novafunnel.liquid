                            assign is_novahair_sales_bundle = true
                            assign nh_sales_cfg = item.properties['_NOVASALE_CONFIG'] | default: item.variant.sku
                            assign nh_sales_parts = nh_sales_cfg | split: '-'
                            assign nh_sales_qty = item.properties['_BUNDLE_SIZE']
                            if nh_sales_qty == blank
                              assign nh_sales_qty = nh_sales_parts[1]
                            endif
                          endif
                          if item.product.handle == 'elastic-dream-internal-bundles'
                            assign is_elastic_bundle = true
                          endif
                          assign novafunnel_cross_sell_image = ''
                          case item.variant.id
                            when 50459892580647
                              assign novafunnel_cross_sell_image = 'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/novahair-hair-gloss-bottle-only-v2.png?v=1789280943'
                            when 51885840072999
                              assign novafunnel_cross_sell_image = 'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/3c8c2338-1207-454e-a4d7-dfd7743f28c6.jpg?v=1786967692'
                            when 51885840138535
                              assign novafunnel_cross_sell_image = 'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/d08ade7c-b095-4092-b83d-dc9b6b5784c1.jpg?v=1786967695'
                            when 51885840400679
                              assign novafunnel_cross_sell_image = 'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/d0e60057-38b4-4066-a555-8a5f6b4c6609.jpg?v=1786967702'
                            when 52010595320103
                              assign novafunnel_cross_sell_image = 'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/342d988e-c92f-4cf5-b5d0-4d673b3e0c0d.png?v=1788651830'
                          endcase
                          assign customer_aria_title = item.product.title
                          if is_novahair_sales_bundle
                            capture customer_aria_title
                              echo 'NovaHair — מארז '
                              echo nh_sales_qty
                              echo ' בקבוקים'
                            endcapture
                          endif
                        -%}
                        <td
                          class="cart-item__media"
                          role="cell"
                          headers="CartDrawer-ColumnProductImage"
                        >
                          {%- if novafunnel_cross_sell_image != blank -%}
                            <img
                              class="cart-item__image"
                              src="{{ novafunnel_cross_sell_image }}"
                              alt="{{ item.product.title | escape }}"
                              loading="eager"
                              decoding="async"
                              width="54"
                              height="54"
                            >
                          {%- elsif is_novahair_sales_bundle -%}
                            {%- assign nh_sales_img = 'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/batch4_1.png?v=1787166128' -%}
                            {%- if nh_sales_qty == '2' -%}
                              {%- assign nh_sales_img = 'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/batch4_2.png?v=1787166132' -%}
                            {%- elsif nh_sales_qty == '6' -%}
                              {%- assign nh_sales_img = 'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/batch4_3.png?v=1787166137' -%}
                            {%- endif -%}
                            <img
                              class="cart-item__image"
                              src="{{ nh_sales_img }}"
                              alt="NovaHair — מארז {{ nh_sales_qty }} בקבוקים"
                              loading="lazy"
                              decoding="async"
                              width="72"
                              height="72"
                            >
                          {%- elsif is_novahair_bundle -%}
                            {%- assign nh_cfg = item.properties['_TIGERA_CONFIG'] | default: '' -%}
                            {%- assign nh_tier = nh_cfg | split: '-' | first -%}
                            {%- if nh_tier == '1' or nh_tier == '2' or nh_tier == '3' -%}
                              {%- assign nh_img = 'novahair-bundle-' | append: nh_tier | append: '.png' -%}
                              <img
                                class="cart-item__image"
                                src="{{ nh_img | asset_url }}"
                                alt="NOVAHAIR מארז {{ nh_tier }}"
                                loading="eager" fetchpriority="high"
                                width="64"
                                height="64"
                                style="width:64px;height:64px;object-fit:cover;border-radius:10px;border:1px solid #EFE9E1;background:#FAF8F5;"
                              >
                            {%- endif -%}
                          {%- elsif is_elastic_bundle -%}
                            {%- assign ed_img = 'carousel-08-bundle-3pack.jpg' -%}
                            {%- if item.variant_id == 51878034538791 -%}
                              {%- assign ed_img = 'carousel-07-bundle-single.jpg' -%}
                            {%- endif -%}
                            <img
                              class="cart-item__image"
                              src="{{ ed_img | asset_url }}"
                              alt="ElasticDream מארז"
                              loading="eager" fetchpriority="high"
