{% if cart != empty %}
{%- liquid
  if cart.currency.iso_code == 'USD'
    assign ship_threshold = 5500
  else
    assign ship_threshold = 19900
  endif
  assign current_total = cart.total_price | default: 0
  if current_total >= ship_threshold
    assign ship_pct = 100
    assign ship_unlocked = true
  else
    assign ship_unlocked = false
    assign ship_diff = ship_threshold | minus: current_total
    assign ship_pct = current_total | times: 100 | divided_by: ship_threshold
    if ship_pct < 4 and current_total > 0
      assign ship_pct = 4
    endif
  endif
-%}
<div
  class="cart-drawer-cro-panel"
  data-free-ship-panel
  data-ship-threshold="{{ ship_threshold }}"
  data-ship-currency="{{ cart.currency.iso_code }}"
  style="margin: 12px 16px; padding: 14px; background: #FFFFFF; border: 1px solid #E7E1D7; border-radius: 14px; direction: rtl; text-align: right;{% if novafunnel_has_sales_bundle %} display:none;{% endif %}"
>
  <div data-ship-copy style="font-size: 13px; font-weight: 800; color: {% if ship_unlocked %}#027A48{% else %}#17231E{% endif %}; margin-bottom: 8px; line-height: 1.4;">
    {%- if ship_unlocked -%}
      זכאית למשלוח חינם!
    {%- else -%}
      חסרים לך עוד ₪{{ ship_diff | money_without_currency }} למשלוח חינם
    {%- endif -%}
  </div>
  <div style="width: 100%; height: 10px; background: #E7E1D7; border-radius: 999px; overflow: hidden;">
    <div data-ship-fill style="width: {{ ship_pct }}%; height: 100%; background: {% if ship_unlocked %}#027A48{% else %}#C5A059{% endif %}; border-radius: 999px;"></div>
  </div>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #F4EFEA; font-size: 11px; font-weight: 700; color: #555; line-height: 1.35;">
    <span>5-14 ימי עסקים</span>
    <span>סליקה מאובטחת</span>
    <span>מוצר מקורי</span>
    <span>שירות לקוחות בעברית</span>
  </div>
</div>
{% endif %}

<details class="novafunnel-mobile-upsells" id="csMobilePanel" hidden>
  <summary class="novafunnel-mobile-upsells__summary">
    <span id="csMobileTitle">רוצה להוסיף מוצר משלים במחיר מיוחד?</span>
    <span class="novafunnel-mobile-upsells__chevron" aria-hidden="true">+</span>
  </summary>
  <div class="novafunnel-mobile-upsells__head">
    <span class="visually-hidden">מוצרים משלימים</span>
    <div class="novafunnel-mobile-upsells__nav" aria-label="ניווט בין מוצרים משלימים">
      <button type="button" class="novafunnel-mobile-upsells__arrow" data-cs-next aria-label="למוצרים הבאים">←</button>
      <button type="button" class="novafunnel-mobile-upsells__arrow" data-cs-previous aria-label="למוצרים הקודמים">→</button>
    </div>
  </div>
  <div class="novafunnel-mobile-upsells__rail" id="csMobileItems"></div>
</details>


</div>
<!-- /.drawer__scroll -->
<div class="drawer__footer">
        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer">
            <summary>
              <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
