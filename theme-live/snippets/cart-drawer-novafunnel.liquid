    return total(alloc)===quantity?alloc:defaultAlloc(quantity,'black');
  }
  function cartMainItem(cart){
    return (cart.items||[]).find(function(item){
      var properties=item.properties||{};
      return properties._CART_PRESENTATION==='novahair-sales'||properties._NOVASALE_CONFIG||[10339305914663,10341269274919].indexOf(Number(item.product_id))>-1;
