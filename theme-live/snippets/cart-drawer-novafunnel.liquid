    }).then(function(){
      window.dispatchEvent(new CustomEvent('novahair:cart-selection-saved',{detail:{pack:'pack'+quantity,alloc:alloc,mode:editorState.isMix?'mix':'single',color:editorState.selected}}));
      closeEditor();
    }).catch(function(error){console.error('NovaFunnel shade editor error:',error);setEditorError(error&&error.message||'לא הצלחנו לשמור את הבחירה. נסי שוב.');save.disabled=false;});
  }
  window.novaFunnelOpenShadeEditor=function(trigger){
    triggerElement=trigger||null;
    ensureEditor().hidden=false;
    setEditorError('');
    novaFunnelCartJson('cart.js').then(function(cart){editorState=cartState(cart);renderEditor();var close=editorRoot().querySelector('[data-novafunnel-editor-close]');if(close)close.focus();}).catch(function(error){console.error('NovaFunnel shade editor load error:',error);setEditorError('לא הצלחנו לטעון את בחירת הגוונים. נסי שוב.');});
  };
})();

if (!window.__novaFunnelCartHandlersBound) {
  window.__novaFunnelCartHandlersBound = true;
  document.addEventListener('click', function(event) {
    var edit = event.target.closest('[data-novafunnel-edit-selection]');
    if (edit) {
      event.preventDefault();
      if(typeof window.novaFunnelOpenShadeEditor==='function')window.novaFunnelOpenShadeEditor(edit);
      return;
    }

    var removeButton = event.target.closest('.novafunnel-cart-drawer cart-remove-button button');
    if (removeButton) {
      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();
      var removeRow=removeButton.closest('tr[data-line-key]');
      novaFunnelChangeLine(removeRow&&removeRow.dataset.lineKey,0,removeButton);
      return;
    }

    var quantityButton = event.target.closest('.novafunnel-cart-drawer quantity-input .quantity__button');
    if (quantityButton) {
      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();
      var quantityRoot = quantityButton.closest('quantity-input');
      var input = quantityRoot && quantityRoot.querySelector('.quantity__input');
      if (!input) return;
      var delta = quantityButton.name === 'plus' ? 1 : -1;
      var next = Math.max(0, Number(input.value || 0) + delta);
      var quantityRow=quantityButton.closest('tr[data-line-key]');
      novaFunnelChangeLine(quantityRow&&quantityRow.dataset.lineKey,next,quantityButton);
    }
  }, true);

  document.addEventListener('change', function(event) {
    var input = event.target.closest('.novafunnel-cart-drawer .quantity__input');
    if (!input) return;
    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();
    var inputRow=input.closest('tr[data-line-key]');
    novaFunnelChangeLine(inputRow&&inputRow.dataset.lineKey,Number(input.value),input);
  }, true);
}

// ===== Cross-sell panel logic: one shared in-drawer source for desktop + mobile =====
(function () {
  var CS_SETS = {
    nova: { title: 'הוסיפי להזמנה במחיר מיוחד', items: [] },
    elastic: { title: 'משלימים את שגרת ElasticDream', items: [{id:51885840433447,name:'מסיכת קולגן לפנים — יחידה בודדת',price:'₪29.90',img:'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/2a6a1cdd-70e0-4f25-9a02-7b1b96f39ed3.jpg?v=1786967705'},{id:51885840466215,name:'קרם עיניים רטינול',price:'₪34.90',img:'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/47f35344-cc55-4ea9-918d-64260c04c249.jpg?v=1786967708'},{id:51885840531751,name:'קרם צוואר ומחשוף רטינול',price:'₪34.90',img:'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/d0d21cac-59a9-4bd2-a71c-51abe41c34f9.jpg?v=1786967711'},{id:51885840564519,name:'קרם פנים לחות מרגיע',price:'₪34.90',img:'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/8b32add9-bfd1-496c-b95c-6f1837e476f6.jpg?v=1786967713'},{id:51885840990503,name:'קרם מיצוק Bee Venom נגד קמטים',price:'₪34.90',img:'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/79a43d1c-9c54-42e3-9759-8810b2834bd8.jpg?v=1786967717'}] }
  };
  var MAIN = { nova: [10339305914663, 10341269274919], elastic: [9671746683175, 10340534026535] };
  var WHITELIST = {};
  [51878069535015, 51880636875047, 51880681472295, 51883494474023, 50459892580647, 51885840138535, 52010595320103, 52010652401959].forEach(function(v){WHITELIST[v]=1;});
  Object.keys(CS_SETS).forEach(function(k){CS_SETS[k].items.forEach(function(i){WHITELIST[i.id]=1;});});
  var MANAGED_BUMPS=[
    {id:52010595320103,name:'מסכת הזנה לשיער',price:'₪49.99',compare:'₪99.90',offer:'מעניקה לחות ומראה רך לאחר הצביעה.',button:'הוסיפי להזמנה',img:'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/342d988e-c92f-4cf5-b5d0-4d673b3e0c0d.png?v=1788651830'},
    {id:52010652401959,name:'סרום קרטין משקם',price:'₪44.99',compare:'₪89.90',offer:'מחליק, מרכך ומעניק ברק לשיער.',button:'הוסיפי להזמנה',img:'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/58336fc7-35f0-44a2-8874-912f4223b029.jpg?v=1788653644'},
    {id:50459892580647,name:'ספריי ברק לשיער',price:'₪39.99',compare:'₪79.90',offer:'שומר על מראה צבע רענן ומעניק ברק.',button:'הוסיפי להזמנה',img:'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/novahair-hair-gloss-bottle-only-v2.png?v=1789280943'}
  ];
  var csResizeTimer=0;

  function cartOfferItems(items){return (Array.isArray(items)?items:[]).map(function(item){return {id:Number(item.variantId),name:String(item.title||''),price:String(item.price||''),compare:String(item.compare||''),offer:String(item.anchorText||''),button:String(item.buttonText||''),img:String(item.imageUrl||''),alt:String(item.imageAlt||'')};}).filter(function(item){return item.id&&item.name&&item.price&&/^https:\/\/cdn\.shopify\.com\//i.test(item.img);});}
  function applyCartOfferConfig(payload){var config=payload&&payload.config;if(!config||!Array.isArray(config.carousel)||!Array.isArray(config.bumps))return;CS_SETS.nova={title:String(config.carouselTitle||'מוצרים משלימים במחיר מיוחד'),items:cartOfferItems(config.carousel)};MANAGED_BUMPS=cartOfferItems(config.bumps);CS_SETS.nova.items.concat(MANAGED_BUMPS).forEach(function(item){WHITELIST[item.id]=1;});csEvaluate();}
  if(!window.novaFunnelCartOfferConfigPromise){window.novaFunnelCartOfferConfigPromise=fetch('/apps/funnels/api/cart-offers-config',{headers:{Accept:'application/json'},credentials:'same-origin',cache:'no-store'}).then(function(response){if(!response.ok)throw new Error('Cart offer config unavailable');return response.json();});}
  window.novaFunnelCartOfferConfigPromise.then(applyCartOfferConfig).catch(function(error){console.warn('NovaFunnel cart offers fallback active',error);});

  function escapeMarkup(value){return String(value||'').replace(/[&<>"']/g,function(character){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character];});}
  function csHide(){var panel=document.getElementById('csMobilePanel');if(panel){panel.hidden=true;panel.open=false;}var bumps=document.getElementById('novafunnelManagedBumps');if(bumps)bumps.hidden=true;}
  function availableItems(set,present){return set.items.filter(function(item){return !present[item.id];});}
  function crossSellMarkup(item){return '<article class="novafunnel-mobile-upsells__card"><div class="novafunnel-mobile-upsells__image"><img src="'+escapeMarkup(item.img)+'" alt="'+escapeMarkup(item.alt||item.name)+'" loading="lazy" decoding="async"></div><div class="novafunnel-mobile-upsells__name">'+escapeMarkup(item.name)+'</div><div class="novafunnel-mobile-upsells__meta"><div class="novafunnel-mobile-upsells__price-row" dir="ltr">'+(item.compare?'<bdi class="novafunnel-mobile-upsells__compare" dir="ltr">'+escapeMarkup(item.compare)+'</bdi>':'')+'<bdi class="novafunnel-mobile-upsells__price" dir="ltr">'+escapeMarkup(item.price)+'</bdi></div>'+(item.offer?'<div class="novafunnel-mobile-upsells__offer">'+escapeMarkup(item.offer)+'</div>':'')+'</div><button type="button" class="novafunnel-mobile-upsells__add" data-vid="'+Number(item.id)+'" data-display-title="'+escapeMarkup(item.name)+'">'+escapeMarkup(item.button||'הוספה')+'</button></article>';}
  function managedBumpMarkup(item,present,step){var checked=!!present[item.id];return '<label class="novafunnel-managed-bump" data-bump-id="'+Number(item.id)+'"><input type="checkbox" data-managed-bump="'+Number(item.id)+'" data-display-title="'+escapeMarkup(item.name)+'" '+(checked?'checked':'')+' aria-label="'+escapeMarkup((item.button||'הוסיפי להזמנה')+' '+item.name)+'"><span class="novafunnel-managed-bump__image"><img src="'+escapeMarkup(item.img)+'" alt="'+escapeMarkup(item.alt||item.name)+'" loading="eager" decoding="async"></span><span class="novafunnel-managed-bump__body"><span class="novafunnel-managed-bump__step">שלב '+Number(step)+'</span><span class="novafunnel-managed-bump__name">'+escapeMarkup(item.name)+'</span>'+(item.offer?'<span class="novafunnel-managed-bump__anchor">'+escapeMarkup(item.offer)+'</span>':'')+'</span><span class="novafunnel-managed-bump__prices">'+(item.compare?'<s class="novafunnel-managed-bump__compare"><bdi dir="ltr">'+escapeMarkup(item.compare)+'</bdi></s>':'')+'<span class="novafunnel-managed-bump__price">רק <bdi dir="ltr">'+escapeMarkup(item.price)+'</bdi></span></span></label>';}
  function renderManagedBumps(key,present){var panel=document.getElementById('novafunnelManagedBumps'),list=document.getElementById('novafunnelManagedBumpsList');if(!panel||!list||key!=='nova'||!MANAGED_BUMPS.length){if(panel)panel.hidden=true;return;}list.innerHTML=MANAGED_BUMPS.map(function(item,index){return managedBumpMarkup(item,present,index+2);}).join('');panel.hidden=false;}
  function csRender(key,present){
    var set=CS_SETS[key],items=availableItems(set,present),mobile=document.getElementById('csMobilePanel'),box=document.getElementById('csMobileItems'),title=document.getElementById('csMobileTitle');
    if(!mobile||!box){csHide();return;}
    if(!items.length){mobile.hidden=true;renderManagedBumps(key,present);return;}
    if(title)title.textContent=set.title;
    box.innerHTML=items.map(crossSellMarkup).join('');
    mobile.hidden=false;
    renderManagedBumps(key,present);
    requestAnimationFrame(updateNavigation);
  }
  function updateNavigation(){
    var rail=document.getElementById('csMobileItems'),next=document.querySelector('[data-cs-next]'),previous=document.querySelector('[data-cs-previous]');
    if(!rail||!next||!previous)return;
    var max=Math.max(0,rail.scrollWidth-rail.clientWidth),position=Math.abs(rail.scrollLeft);
    previous.disabled=position<3;
    next.disabled=position>max-3;
  }
  function scrollProducts(direction){
    var rail=document.getElementById('csMobileItems');if(!rail)return;
    var card=rail.querySelector('.novafunnel-mobile-upsells__card');
    var step=(card?card.getBoundingClientRect().width:rail.clientWidth*.48)+9;
    rail.scrollBy({left:direction*step,behavior:'smooth'});
    setTimeout(updateNavigation,260);
  }
  function csEvaluate(){
    var host=document.querySelector('cart-drawer');
    if(!host||!host.classList.contains('active')){csHide();return;}
    var groups={},ok=true,present={};
    host.querySelectorAll('tr.cart-item[data-product-id][data-variant-id]').forEach(function(row){
      var variantId=Number(row.dataset.variantId),productId=Number(row.dataset.productId);
      present[variantId]=1;
      if(WHITELIST[variantId])return;
      if(MAIN.nova.indexOf(productId)>-1)groups.nova=1;
      else if(MAIN.elastic.indexOf(productId)>-1)groups.elastic=1;
      else ok=false;
    });
    var keys=Object.keys(groups);
    if(!ok||keys.length!==1){csHide();return;}
    csRender(keys[0],present);
  }
  function csGroupForVariant(variantId){
    var keys=Object.keys(CS_SETS);
    for(var i=0;i<keys.length;i++){
      if(CS_SETS[keys[i]].items.some(function(item){return Number(item.id)===Number(variantId);}))return keys[i];
    }
    return '';
  }
  function csAdd(variantId,button){
    if(button&&button.disabled)return Promise.resolve();
    if(button){button.disabled=true;button.setAttribute('aria-busy','true');button.textContent='מוסיף...';}
    var group=csGroupForVariant(variantId);
    var displayTitle=button&&button.getAttribute('data-display-title')||'';
    return window.novaFunnelAddUniqueLine(
      {id:Number(variantId),quantity:1,properties:{'_NOVAFUNNEL_ROLE':'CROSS_SELL','_NOVAFUNNEL_GROUP':group,'_CART_DISPLAY_TITLE':displayTitle}},
      {role:'CROSS_SELL',openDrawer:false,requiredProductIds:MAIN[group]||[]}
    ).then(function(){
      if(button&&document.body.contains(button)){button.removeAttribute('aria-busy');button.textContent='נוסף ✓';}
    }).catch(function(error){
      console.error('NovaFunnel cross-sell add error',error);
      if(error&&error.code==='NOVAFUNNEL_MAIN_REQUIRED'){
        csEvaluate();
        return;
      }
      if(button&&document.body.contains(button)){button.removeAttribute('aria-busy');button.disabled=false;button.textContent='נסי שוב';}
    });
  }
  var originalSwap=window.swapDrawerFromSections;
  window.swapDrawerFromSections=function(sections){var result=originalSwap(sections);requestAnimationFrame(csEvaluate);return result;};
  var originalRefresh=window.refreshCartDrawer;
  window.refreshCartDrawer=function(openAfter){var result=originalRefresh(openAfter);if(result&&result.then)result.then(csEvaluate);return result;};
  document.addEventListener('click',function(event){
    var button=event.target.closest('#csMobilePanel [data-vid]');
    if(button){event.preventDefault();event.stopPropagation();event.stopImmediatePropagation();csAdd(Number(button.getAttribute('data-vid')),button);return;}
    if(event.target.closest('[data-cs-next]')){event.preventDefault();scrollProducts(-1);return;}
    if(event.target.closest('[data-cs-previous]')){event.preventDefault();scrollProducts(1);}
  },true);
  document.addEventListener('DOMContentLoaded',function(){
    var host=document.querySelector('cart-drawer');
    if(host)new MutationObserver(csEvaluate).observe(host,{attributes:true,attributeFilter:['class']});
    var mobilePanel=document.getElementById('csMobilePanel');
    if(mobilePanel)mobilePanel.addEventListener('toggle',function(){if(mobilePanel.open)requestAnimationFrame(updateNavigation);});
    var mainRows=document.querySelectorAll('tr[data-novafunnel-main-offer="true"]');
    var invalidMain=mainRows.length>1||Array.prototype.some.call(mainRows,function(row){var input=row.querySelector('.quantity__input');return input&&Number(input.value)!==1;});
    if(invalidMain&&typeof window.novaFunnelNormalizeMainOffer==='function')window.novaFunnelNormalizeMainOffer({openDrawer:false}).catch(function(error){console.error('NovaFunnel main offer repair error',error);});
    window.addEventListener('resize',function(){clearTimeout(csResizeTimer);csResizeTimer=setTimeout(csEvaluate,100);},{passive:true});
    document.addEventListener('scroll',function(event){if(event.target&&event.target.id==='csMobileItems')updateNavigation();},true);
  });
  window.novaFunnelEvaluateCrossSells=csEvaluate;
})();
// Shipping bar is server-rendered inside the drawer — no cart.js fetch on page load.
if (window.subscribe && window.PUB_SUB_EVENTS && window.PUB_SUB_EVENTS.cartUpdate) {
  subscribe(PUB_SUB_EVENTS.cartUpdate, function () { syncFreeShippingBar(); });
}
