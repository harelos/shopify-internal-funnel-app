    .novafunnel-cart-drawer tr[data-novafunnel-main-offer="true"] .cart-item__image { width:54px !important;height:56px !important; }
    .novafunnel-cart-drawer tr[data-novafunnel-main-offer="true"] .novafunnel-selection { width:100%;min-height:24px;padding-inline:7px;font-size:9px; }
    .novafunnel-cart-drawer tr[data-novafunnel-main-offer="true"] .novafunnel-selection--mixed { min-height:24px; }
    .novafunnel-cart-drawer tr[data-novafunnel-main-offer="true"] .novafunnel-selection--mixed .novafunnel-selection__value { display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
