  }
  cart-drawer .cart__checkout-button:hover {
    background: #0F1A15 !important;
  }
  [data-ship-fill] {
    transition: width 0.45s ease, background 0.35s ease !important;
  }
  .price.price--end {
    color: #17231E !important;
  }
  .cart-drawer-bumps label {
    transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
  }
  .cart-drawer-bumps label:hover {
    border-color: #C5A059 !important;
    box-shadow: 0 2px 10px rgba(23, 35, 30, 0.07) !important;
  }
  .totals__total-value {
    letter-spacing: 0.3px;
  }
  /* Compact, aesthetic quantity + remove row */
  cart-drawer .cart-item__quantity {
    gap: 8px !important;
    margin-top: 8px !important;
  }
  cart-drawer quantity-input.quantity {
    height: 34px !important;
    min-height: 34px !important;
  }
  cart-drawer .quantity__button {
    width: 28px !important;
    height: 34px !important;
  }
  cart-drawer .quantity__button .svg-wrapper,
  cart-drawer .quantity__button svg {
    width: 12px !important;
    height: 12px !important;
  }
  cart-drawer .quantity__input {
    width: 30px !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    padding: 0 !important;
  }
  cart-drawer cart-remove-button .cart-remove-button {
    width: 30px !important;
    height: 30px !important;
    min-height: 30px !important;
    border-radius: 8px !important;
  }
  cart-drawer cart-remove-button .svg-wrapper,
  cart-drawer cart-remove-button svg {
    width: 14px !important;
    height: 14px !important;
  }
  cart-drawer .cart-item__price-wrapper .price--end {
    font-size: 16px !important;
  }
  cart-drawer .cart-item__image {
    border-radius: 10px !important;
  }
  /* Mobile: compact item rows — nothing clipped, price always visible */
  @media (max-width: 749px) {
    cart-drawer table.cart-items,
    cart-drawer table.cart-items tbody {
      display: block !important;
      width: 100% !important;
    }
    cart-drawer tr.cart-item {
      display: grid !important;
      grid-template-columns: 58px minmax(0, 1fr) auto !important;
      grid-template-rows: auto auto !important;
      column-gap: 10px !important;
      align-items: start;
      padding: 12px 0 !important;
      border-bottom: 1px solid #F1ECE4;
    }
    cart-drawer .cart-item__media { grid-row: 1 / 3 !important; grid-column: 1 !important; padding: 0 !important; }
    cart-drawer .cart-item__details { grid-row: 1 !important; grid-column: 2 !important; min-width: 0 !important; padding: 0 !important; }
    cart-drawer .cart-item__totals { grid-row: 1 !important; grid-column: 3 !important; padding: 2px 0 0 !important; white-space: nowrap; }
    cart-drawer .cart-item__quantity { grid-row: 2 !important; grid-column: 2 / 4 !important; margin-top: 10px !important; padding: 0 !important; justify-content: flex-start; }
    cart-drawer .cart-item__image { width: 58px !important; height: 58px !important; }
    cart-drawer .cart-item__name { font-size: 13.5px !important; }
    cart-drawer .cart-item__price-wrapper .price--end { font-size: 15px !important; }
    cart-drawer .drawer__header { padding: 12px 16px !important; }
    cart-drawer .drawer__heading { font-size: 17px !important; }
    cart-drawer .cart-drawer-cro-panel { margin: 12px 0 !important; }
    cart-drawer .cart-drawer-bumps { margin: 12px 0 !important; }
  }
</style>

