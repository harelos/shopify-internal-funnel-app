                  <tbody role="rowgroup" data-novafunnel-cart-rows>
                    {%- for item in cart.items -%}
                      <tr
                        id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                        class="cart-item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}{% if item.properties['_NOVAFUNNEL_ROLE'] == 'CROSS_SELL' or item.properties['_NOVAFUNNEL_ROLE'] == 'BUMP' or item.variant.id == 51878069535015 or item.variant.id == 51880636875047 or item.variant.id == 51880681472295 or item.variant.id == 50459892580647 or item.variant.id == 51885840072999 or item.variant.id == 51885840138535 or item.variant.id == 51885840400679 or item.variant.id == 52010595320103 %} novafunnel-addon-item{% endif %}{% if item.properties['_NOVAFUNNEL_ROLE'] == 'BUMP' or item.variant.id == 51878069535015 or item.variant.id == 51880636875047 or item.variant.id == 51880681472295 %} novafunnel-bump-item{% endif %}"
                        data-line-key="{{ item.key }}"
                        data-product-id="{{ item.product.id }}"
                        data-variant-id="{{ item.variant.id }}"
                        data-novafunnel-main-offer="{% if item.product.handle == 'novahair-funnel-internal' %}true{% else %}false{% endif %}"
                        data-novafunnel-order="{% if item.product.handle == 'novahair-funnel-internal' %}0{% elsif item.properties['_NOVAFUNNEL_ROLE'] == 'CROSS_SELL' or item.properties['_NOVAFUNNEL_ROLE'] == 'BUMP' or item.variant.id == 50459892580647 or item.variant.id == 51885840072999 or item.variant.id == 51885840138535 or item.variant.id == 51885840400679 or item.variant.id == 52010595320103 %}1{% else %}2{% endif %}"
                        role="row"
                        {% if item.parent_relationship.parent != null %}
                          aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                        {% endif %}
                      >
                        {%- liquid
                          assign is_novahair_bundle = false
                          assign is_novahair_sales_bundle = false
                          assign is_elastic_bundle = false
                          assign customer_display_title = item.properties['_CART_DISPLAY_TITLE'] | default: ''
