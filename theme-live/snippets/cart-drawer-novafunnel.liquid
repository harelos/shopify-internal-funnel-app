<script>
let novaFunnelViewportFrame;
function syncNovaFunnelCartViewport() {
  const host = document.querySelector('.novafunnel-cart-drawer');
  if (!host) return;
  const viewport = window.visualViewport;
  const height = viewport && viewport.height ? viewport.height : window.innerHeight;
  if (height > 0) host.style.setProperty('--novafunnel-viewport-height', `${Math.round(height)}px`);
}
function queueNovaFunnelCartViewportSync() {
  if (novaFunnelViewportFrame) cancelAnimationFrame(novaFunnelViewportFrame);
  novaFunnelViewportFrame = requestAnimationFrame(() => {
    novaFunnelViewportFrame = null;
    syncNovaFunnelCartViewport();
  });
}
syncNovaFunnelCartViewport();
window.addEventListener('resize', queueNovaFunnelCartViewportSync, { passive: true });
window.addEventListener('orientationchange', queueNovaFunnelCartViewportSync, { passive: true });
if (window.visualViewport) {
  window.visualViewport.addEventListener('resize', queueNovaFunnelCartViewportSync, { passive: true });
}

function orderNovaFunnelCartRows(root) {
  const scope = root || document;
  scope.querySelectorAll('[data-novafunnel-cart-rows]').forEach((body) => {
    const rows = Array.from(body.children).filter((row) => row.hasAttribute('data-novafunnel-order'));
    const ordered = rows
      .map((row, index) => ({ row, index, rank: Number(row.dataset.novafunnelOrder || 2) }))
      .sort((a, b) => a.rank - b.rank || a.index - b.index);
    if (ordered.every((entry, index) => entry.row === rows[index])) return;
    const fragment = body.ownerDocument.createDocumentFragment();
    ordered.forEach((entry) => fragment.appendChild(entry.row));
    body.appendChild(fragment);
  });
}
window.orderNovaFunnelCartRows = orderNovaFunnelCartRows;
orderNovaFunnelCartRows(document);

// Swap drawer + cart bubble straight from a cart endpoint `sections` response (single round trip)
function swapDrawerFromSections(sections) {
  const drawerHtml = sections && (sections['cart-drawer-novafunnel'] || sections['cart-drawer']);
  if (!drawerHtml) return false;
  const host = document.querySelector('cart-drawer');
  const doc = new DOMParser().parseFromString(drawerHtml, 'text/html');
  const newDrawer = doc.querySelector('cart-drawer');
  const newInner = doc.querySelector('#CartDrawer');
  const currentInner = document.querySelector('#CartDrawer');
  if (newInner && currentInner) {
    orderNovaFunnelCartRows(newInner);
    currentInner.innerHTML = newInner.innerHTML;
  }
  if (host) {
    const empty = newDrawer ? newDrawer.classList.contains('is-empty') : false;
    host.classList.toggle('is-empty', empty);
    const overlay = host.querySelector('#CartDrawer-Overlay');
    if (overlay) overlay.addEventListener('click', host.close.bind(host));
  }
  try {
    if (sections['cart-icon-bubble']) {
      const bubbleDoc = new DOMParser().parseFromString(sections['cart-icon-bubble'], 'text/html');
      const newBubble = bubbleDoc.querySelector('.shopify-section') || bubbleDoc.body;
      const currentBubble = document.getElementById('cart-icon-bubble');
      if (currentBubble && newBubble) {
        const next = newBubble.querySelector('#cart-icon-bubble') || newBubble.firstElementChild;
        if (next) currentBubble.innerHTML = next.innerHTML;
      }
    }
  } catch (e) {}
  return true;
}
window.swapDrawerFromSections = swapDrawerFromSections;

async function refreshCartDrawer(openAfter) {
  const host = document.querySelector('cart-drawer');
  // Open the drawer IMMEDIATELY (perceived-instant); fresh content swaps in below.
  if (openAfter && host) {
    if (typeof host.open === 'function') host.open();
    else host.classList.add('animate', 'active');
  }
  try {
    const rootPath = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    // Fetch drawer + cart-bubble sections in parallel for speed
    const [res, bubbleRes] = await Promise.all([
      fetch(`${rootPath}?section_id=cart-drawer-novafunnel`),
      fetch(`${rootPath}?section_id=cart-icon-bubble`).catch(() => null)
    ]);
    const html = await res.text();
    const doc = new DOMParser().parseFromString(html, 'text/html');
    const newDrawer = doc.querySelector('cart-drawer');
    const newInner = doc.querySelector('#CartDrawer');
    const currentInner = document.querySelector('#CartDrawer');

    if (newInner && currentInner) {
      orderNovaFunnelCartRows(newInner);
      currentInner.innerHTML = newInner.innerHTML;
    }
    // No extra cart.js fetch here — server already rendered the shipping bar correctly.
    if (host) {
      const empty = newDrawer ? newDrawer.classList.contains('is-empty') : false;
      host.classList.toggle('is-empty', empty);
      const overlay = host.querySelector('#CartDrawer-Overlay');
      if (overlay) overlay.addEventListener('click', host.close.bind(host));
      if (openAfter && typeof host.open === 'function') host.open();
      else if (openAfter) host.classList.add('animate', 'active');
    }

    try {
      if (bubbleRes) {
        const bubbleHtml = await bubbleRes.text();
        const bubbleDoc = new DOMParser().parseFromString(bubbleHtml, 'text/html');
        const newBubble = bubbleDoc.querySelector('.shopify-section') || bubbleDoc.body;
        const currentBubble = document.getElementById('cart-icon-bubble');
        if (currentBubble && newBubble) {
          const next = newBubble.querySelector('#cart-icon-bubble') || newBubble.firstElementChild;
          if (next) currentBubble.innerHTML = next.innerHTML;
        }
      }
    } catch (e) {}
  } catch(e) {
    console.error('Refresh drawer error:', e);
  }
}
window.refreshCartDrawer = refreshCartDrawer;

function formatShipMoney(cents, currency) {
  const value = Math.max(0, Number(cents) || 0) / 100;
  const fixed = value.toFixed(2);
  return (currency === 'USD' ? '$' : '₪') + fixed;
}

function updateFreeShippingBar(totalPrice, currencyHint) {
  const panel = document.querySelector('[data-free-ship-panel]');
  if (!panel) return;
  const currency = currencyHint || panel.getAttribute('data-ship-currency') || 'ILS';
  const threshold = currency === 'USD' ? 5500 : 19900;
  panel.setAttribute('data-ship-threshold', String(threshold));
  panel.setAttribute('data-ship-currency', currency);
  const total = Number(totalPrice || 0);
  const copy = panel.querySelector('[data-ship-copy]');
  const fill = panel.querySelector('[data-ship-fill]');
  if (!copy || !fill) return;
  if (total >= threshold) {
    copy.textContent = 'זכאית למשלוח חינם!';
    copy.style.color = '#027A48';
    fill.style.width = '100%';
    fill.style.background = '#027A48';
  } else {
    let pct = threshold ? Math.floor((total * 100) / threshold) : 0;
    if (total > 0 && pct < 8) pct = 8;
    copy.textContent = 'חסרים לך עוד ' + formatShipMoney(threshold - total, currency) + ' למשלוח חינם';
    copy.style.color = '#17231E';
    fill.style.width = pct + '%';
    fill.style.background = '#C5A059';
  }
}

async function syncFreeShippingBar() {
  try {
    const rootPath = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    const cart = await (await fetch(rootPath + 'cart.js', { headers: { Accept: 'application/json' } })).json();
    updateFreeShippingBar(cart.total_price, cart.currency);
  } catch (e) {}
}



(function ensureNovaFunnelCartQueue(){
  if(window.novaFunnelEnqueueCartMutation)return;
  var state={tail:Promise.resolve(),pending:Object.create(null)};
  window.novaFunnelEnqueueCartMutation=function(key,job){
    key=String(key||'cart');
    if(state.pending[key])return state.pending[key];
    var run=state.tail.catch(function(){}).then(job);
    state.tail=run.catch(function(){});
    state.pending[key]=run.finally(function(){delete state.pending[key];});
    return state.pending[key];
  };
})();

function novaFunnelStatus(anchor,message,isError){
  if(!anchor)return;
  var label=anchor.closest('label')||anchor.parentElement;
  if(!label)return;
  var status=label.querySelector('.novafunnel-cart-status');
  if(!status){status=document.createElement('div');status.className='novafunnel-cart-status';label.appendChild(status);}
  status.textContent=message||'';
  status.classList.toggle('is-error',!!isError);
}

function novaFunnelChangeLine(lineKey,quantity,trigger){
  if(!lineKey)return Promise.resolve();
  var updatingRow=trigger&&trigger.closest&&trigger.closest('tr[data-line-key]');
  if(updatingRow&&updatingRow.dataset.novafunnelMainOffer==='true'&&Number(quantity)<=0&&typeof window.novaFunnelRemoveMainOffer==='function'){
    if(trigger)trigger.disabled=true;
    updatingRow.classList.add('is-updating');
    updatingRow.setAttribute('aria-busy','true');
    return window.novaFunnelRemoveMainOffer({
      openDrawer:false,
      dependentGroup:'nova',
      dependentVariantIds:[51878069535015,51880636875047,51880681472295,51883494474023,50459892580647,51885840072999,51885840138535,51885840400679,52010595320103,52010652401959]
    }).catch(function(error){
      console.error('NovaFunnel main offer removal error:',error);
      return window.refreshCartDrawer(false);
    }).finally(function(){
      if(trigger&&document.body.contains(trigger))trigger.disabled=false;
      if(document.body.contains(updatingRow)){updatingRow.classList.remove('is-updating');updatingRow.removeAttribute('aria-busy');}
    });
  }
  if(updatingRow&&updatingRow.dataset.novafunnelMainOffer==='true'&&Number(quantity)>0)quantity=1;
  if(trigger)trigger.disabled=true;
  if(updatingRow){updatingRow.classList.add('is-updating');updatingRow.setAttribute('aria-busy','true');}
  return window.novaFunnelEnqueueCartMutation('line:'+lineKey,function(){
    var rootPath=(window.Shopify&&window.Shopify.routes&&window.Shopify.routes.root)||'/';
    return fetch(rootPath+'cart/change.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({id:String(lineKey),quantity:Math.max(0,Number(quantity)||0),sections:['cart-drawer-novafunnel','cart-icon-bubble']})})
      .then(function(response){return response.json().catch(function(){return null;}).then(function(data){if(!response.ok||!data)throw new Error((data&&(data.description||data.message))||'Cart update failed');return data;});})
      .then(function(data){if(!window.swapDrawerFromSections(data.sections))return window.refreshCartDrawer(false);})
      .catch(function(error){console.error('NovaFunnel cart line update error:',error);return window.refreshCartDrawer(false);})
      .finally(function(){
        if(trigger&&document.body.contains(trigger))trigger.disabled=false;
        if(updatingRow&&document.body.contains(updatingRow)){updatingRow.classList.remove('is-updating');updatingRow.removeAttribute('aria-busy');}
      });
  });
}
window.novaFunnelChangeLine=novaFunnelChangeLine;

(function bindNovaFunnelShadeEditor(){
  if(window.__novaFunnelShadeEditorBound)return;
  window.__novaFunnelShadeEditorBound=true;
  var shades=[
    {key:'black',name:'שחור טבעי',asset:'novahair-shade-natural-black.webp'},
    {key:'darkbrown',name:'חום כהה',asset:'novahair-shade-dark-brown.webp'},
    {key:'mediumbrown',name:'חום בינוני',asset:'novahair-shade-medium-brown.webp',isNew:true},
    {key:'lightbrown',name:'חום בהיר',asset:'novahair-shade-light-brown.webp'},
    {key:'purple',name:'סגול חציל',asset:'novahair-shade-eggplant-purple.webp'},
    {key:'red',name:'אדום יין',asset:'novahair-shade-wine-red.webp'}
  ];
  var shadeByKey={};
  shades.forEach(function(shade){shadeByKey[shade.key]=shade;});
  var keys=shades.map(function(shade){return shade.key;});
  var editorState=null;
  var triggerElement=null;
  var mapPromise=null;

  function imageUrl(shade){return '/cdn/shop/t/9/assets/'+shade.asset+'?width=144';}
