{
  "name": "shopify-funnel-control",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }
  ],
  "vars": {
    "RUNTIME": "cloudflare",
    "ANALYTICS_MODE": "LIVE",
    "REPORTING_TIMEZONE": "Asia/Jerusalem",
    "REPORTING_CURRENCY": "USD",
    "META_AD_ACCOUNT_ID": "act_676516688178386",
    "META_AD_ACCOUNT_CURRENCY": "USD",
    "META_GRAPH_API_VERSION": "v23.0",
    // Restored 2026-09-17: the 11:46 deploy dropped these and the guardian
    // silently switched itself off (it checks COMMENT_GUARDIAN_ENABLED).
    "COMMENT_GUARDIAN_ENABLED": "true",
    "COMMENT_GUARDIAN_MODE": "live",
    "COMMENT_GUARDIAN_AD_ACCOUNT_ID": "act_676516688178386",
    "COMMENT_GUARDIAN_PAGE_ID": "620240831165337",
    // Overwritten by scripts/deploy-guard.mjs on every deploy; read by /api/version.
    "BUILD_SHA": "unknown",
    "BUILD_BRANCH": "unknown",
    "BUILD_TIME": "unknown",
    "BUILD_FROM": "unknown",
    "NOVAHAIR_POPUP_VERSION": "novahair_popup_v1",
    "NOVAHAIR_POPUP_COUPON": "NOVA10",
    "POSTHOG_PROJECT_API_KEY": "phc_AyNmzdT6Nky4RZX3XCBBCun4RrC2ThFFvsC9km5pTpr5",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "OPENROUTER_VISION_MODEL": "google/gemini-2.5-flash",
    "NOVAHAIR_EMAIL_SERVICE_URL": "https://novahair-email-service-production.up.railway.app",
    "APP_URL": "https://shopify-funnel-control.tigerbrands-funnel.workers.dev",
    "SHOP_DOMAIN": "jacobfelipe.myshopify.com",
    "ALLOWED_SHOP_DOMAIN": "jacobfelipe.myshopify.com",
    "SHOPIFY_DISTRIBUTION": "custom",
    "SHOPIFY_API_VERSION": "2026-07",
    "SHOPIFY_SCOPES": "read_orders,read_customers,write_customers,read_products,read_discounts,write_discounts,read_reports,read_customer_events,read_pixels,write_app_proxy,write_pixels",
    "SHOPIFY_APP_PROXY_URL": "https://shopify-funnel-control.tigerbrands-funnel.workers.dev/apps/funnels",
    "SHOPIFY_APP_PROXY_PATH": "/apps/funnels",
    "SHOPIFY_LIVE_CONNECT": "true",
    "SHOPIFY_REQUIRE_AUTH": "true",
    "SHOPIFY_PIXEL_INGEST_ENABLED": "true",
    "SUPPORT_AI_DRAFTS_ENABLED": "true",
    "SUPPORT_WORKER_SEND": "true",
    // When the real answer has to wait for a person, the customer is told that
    // within the minute instead of hearing nothing for days.
    "SUPPORT_ESCALATION_ACK_ENABLED": "true",
    "SHIPMENT_OUTREACH_ENABLED": "true",
    "OWNER_DIGEST_ENABLED": "true",
    "SHOPIFY_STOREFRONT_DOMAIN": "tigerbrandsglobal.com",
    "SHOPIFY_PAGE_IMPORT_ALLOWED_HOSTS": "tigerbrandsglobal.com",
    "NOVAHAIR_CJ_AUTO_CREATE_ENABLED": "true",
    "NOVAHAIR_CJ_AUTO_CREATE_MIN_ORDER_NUMBER": "4378",
    "NOVAHAIR_CJ_AUTO_CREATE_SANDBOX": "false"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Static assets are normally served straight from the edge before the
    // Worker runs, which bypassed serveAdminHtml and shipped the literal
    // %SHOPIFY_API_KEY% placeholder to App Bridge. Admin HTML must go through
    // the Worker so the client ID is injected; everything else still serves
    // directly from the asset store.
    "run_worker_first": ["/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopify-funnel-control-db",
      "database_id": "3b3d2e40-28b3-456f-9109-2607fbc51b17"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
,
  // A deploy target that is not the live storefront. Point a staging deploy at
  // it with `npm run deploy:staging` and smoke-test that URL before
  // shipping to production.
  "env": {
    "staging": {
      "name": "shopify-funnel-control-staging",
      "vars": {
      "RUNTIME": "cloudflare",
      "ANALYTICS_MODE": "LIVE",
      "REPORTING_TIMEZONE": "Asia/Jerusalem",
      "REPORTING_CURRENCY": "USD",
      "META_AD_ACCOUNT_ID": "act_676516688178386",
      "META_AD_ACCOUNT_CURRENCY": "USD",
      "META_GRAPH_API_VERSION": "v23.0",
      "NOVAHAIR_POPUP_VERSION": "novahair_popup_v1",
      "NOVAHAIR_POPUP_COUPON": "NOVA10",
      "POSTHOG_PROJECT_API_KEY": "phc_AyNmzdT6Nky4RZX3XCBBCun4RrC2ThFFvsC9km5pTpr5",
      "POSTHOG_HOST": "https://us.i.posthog.com",
      "OPENROUTER_VISION_MODEL": "google/gemini-2.5-flash",
      "NOVAHAIR_EMAIL_SERVICE_URL": "https://novahair-email-service-production.up.railway.app",
      "APP_URL": "https://shopify-funnel-control-staging.tigerbrands-funnel.workers.dev",
      "SHOP_DOMAIN": "jacobfelipe.myshopify.com",
      "ALLOWED_SHOP_DOMAIN": "jacobfelipe.myshopify.com",
      "SHOPIFY_DISTRIBUTION": "custom",
      "SHOPIFY_API_VERSION": "2026-07",
      "SHOPIFY_SCOPES": "read_orders,read_customers,write_customers,read_products,read_discounts,write_discounts,read_reports,read_customer_events,read_pixels,write_app_proxy,write_pixels",
      "SHOPIFY_APP_PROXY_URL": "https://shopify-funnel-control-staging.tigerbrands-funnel.workers.dev/apps/funnels",
      "SHOPIFY_APP_PROXY_PATH": "/apps/funnels",
      "SHOPIFY_LIVE_CONNECT": "true",
      "SHOPIFY_REQUIRE_AUTH": "true",
      "SHOPIFY_PIXEL_INGEST_ENABLED": "true",
      "SUPPORT_AI_DRAFTS_ENABLED": "false",
      "SUPPORT_WORKER_SEND": "false",
      "SUPPORT_ESCALATION_ACK_ENABLED": "false",
      "SHIPMENT_OUTREACH_ENABLED": "false",
      "OWNER_DIGEST_ENABLED": "false",
      "SHOPIFY_STOREFRONT_DOMAIN": "tigerbrandsglobal.com",
      "SHOPIFY_PAGE_IMPORT_ALLOWED_HOSTS": "tigerbrandsglobal.com",
      "NOVAHAIR_CJ_AUTO_CREATE_ENABLED": "false",
      "NOVAHAIR_CJ_AUTO_CREATE_MIN_ORDER_NUMBER": "4378",
      "NOVAHAIR_CJ_AUTO_CREATE_SANDBOX": "false",
      "COMMENT_GUARDIAN_ENABLED": "false"
      }
    }
  }
}
