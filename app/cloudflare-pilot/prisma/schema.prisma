generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
  engineType = "client"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shop {
  id        String   @id @default(uuid())
  domain    String   @unique
  createdAt DateTime @default(now())
  funnels   Funnel[]
  visitors  Visitor[]
  events    Event[]
  checkouts CheckoutAttribution[]
  orders    OrderAttribution[]
  webhookDeliveries ShopifyWebhookDelivery[]
  elementTemplates ElementTemplate[]
  elementSlots ElementSlot[]
  elementExposures ElementExposure[]
  cartElementAttributions CartElementAttribution[]
  checkoutElementAttributions CheckoutElementAttribution[]
  orderElementAttributions OrderElementAttribution[]
  supportMailboxes SupportMailbox[]
  supportCustomers SupportCustomer[]
  supportConversations SupportConversation[]
  supportVoiceExamples SupportVoiceExample[]
}

model Funnel {
  id         String   @id @default(uuid())
  shopId     String
  name       String
  slug       String
  status     String   @default("DRAFT")
  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  shop       Shop     @relation(fields: [shopId], references: [id])
  steps      Step[]
  events     Event[]

  @@unique([shopId, slug])
  @@index([shopId, status])
}

model Step {
  id         String   @id @default(uuid())
  funnelId   String
  position   Int
  name       String
  kind       String   @default("LANDING")
  createdAt  DateTime @default(now())
  funnel     Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  variants   Variant[]
  experiment Experiment?
  events     Event[]

  @@unique([funnelId, position])
  @@index([funnelId])
}

model Variant {
  id                 String   @id @default(uuid())
  stepId             String
  name               String
  publishedVersionId String?  @unique
  sourceType         String   @default("APP_HTML")
  sourceUrl          String?
  sourceTitle        String?
  sourceImportedAt   DateTime?
  createdAt          DateTime @default(now())
  step               Step     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  versions           ContentVersion[]
  allocations        ExperimentAllocation[]
  assignments        Assignment[]
  events             Event[]

  @@unique([stepId, name])
  @@index([stepId])
}

model ContentVersion {
  id             String   @id @default(uuid())
  variantId      String
  revision       Int
  state          String   @default("DRAFT")
  rawHtml        String
  normalizedHtml String
  portReport     String   @default("{}")
  createdAt      DateTime @default(now())
  publishedAt    DateTime?
  variant        Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, revision])
  @@index([variantId, state])
}

model Experiment {
  id                String   @id @default(uuid())
  stepId            String   @unique
  status            String   @default("DRAFT")
  allocationVersion Int      @default(1)
  createdAt         DateTime @default(now())
  step              Step     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  allocations       ExperimentAllocation[]
  assignments       Assignment[]
}

model ExperimentAllocation {
  id                String   @id @default(uuid())
  experimentId      String
  variantId         String
  weightBasisPoints Int
  experiment        Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant           Variant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, variantId])
  @@index([experimentId])
}

model Visitor {
  id               String   @id @default(uuid())
  shopId           String
  anonymousKeyHash String
  createdAt        DateTime @default(now())
  shop             Shop     @relation(fields: [shopId], references: [id])
  assignments      Assignment[]
  events           Event[]
  checkouts        CheckoutAttribution[]
  elementAssignments ElementAssignment[]
  elementExposures ElementExposure[]
  cartElementAttributions CartElementAttribution[]
  checkoutElementAttributions CheckoutElementAttribution[]

  @@unique([shopId, anonymousKeyHash])
}

model ElementTemplate {
  id            String        @id @default(uuid())
  shopId        String
  key           String
  name          String
  type          String        @default("GALLERY")
  schemaVersion Int           @default(1)
  schemaJson    String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  slots         ElementSlot[]

  @@unique([shopId, key])
  @@index([shopId, type])
}

model ElementSlot {
  id             String             @id @default(uuid())
  shopId         String
  templateId     String
  pagePath       String
  slotKey        String
  name           String
  targetSelector String
  status         String             @default("DRAFT")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  shop           Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  template       ElementTemplate    @relation(fields: [templateId], references: [id])
  variants       ElementVariant[]
  experiment     ElementExperiment?
  exposures      ElementExposure[]
  cartAttributions CartElementAttribution[]
  checkoutAttributions CheckoutElementAttribution[]
  orderAttributions OrderElementAttribution[]

  @@unique([shopId, pagePath, slotKey])
  @@index([shopId, status])
}

model ElementVariant {
  id                 String                        @id @default(uuid())
  slotId             String
  key                String
  name               String
  isControl          Boolean                       @default(false)
  publishedVersionId String?                       @unique
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  slot               ElementSlot                   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  versions           ElementVariantVersion[]
  allocations        ElementExperimentAllocation[]
  assignments        ElementAssignment[]
  exposures          ElementExposure[]
  cartAttributions   CartElementAttribution[]
  checkoutAttributions CheckoutElementAttribution[]
  orderAttributions  OrderElementAttribution[]

  @@unique([slotId, key])
  @@index([slotId])
}

model ElementVariantVersion {
  id          String         @id @default(uuid())
  variantId   String
  revision    Int
  state       String         @default("DRAFT")
  payloadJson String
  createdAt   DateTime       @default(now())
  publishedAt DateTime?
  variant     ElementVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, revision])
  @@index([variantId, state])
}

model ElementExperiment {
  id                String                        @id @default(uuid())
  slotId            String                        @unique
  key               String                        @unique
  status            String                        @default("DRAFT")
  allocationVersion Int                           @default(1)
  posthogFlagKey    String?
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  slot              ElementSlot                   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  allocations       ElementExperimentAllocation[]
  assignments       ElementAssignment[]
  exposures         ElementExposure[]
  cartAttributions CartElementAttribution[]
  checkoutAttributions CheckoutElementAttribution[]
  orderAttributions OrderElementAttribution[]
}

model ElementExperimentAllocation {
  id                String            @id @default(uuid())
  experimentId      String
  variantId         String
  weightBasisPoints Int
  experiment        ElementExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant           ElementVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, variantId])
  @@index([experimentId])
}

model ElementAssignment {
  id                String            @id @default(uuid())
  visitorId         String
  experimentId      String
  variantId         String
  allocationVersion Int               @default(1)
  assignedAt        DateTime           @default(now())
  visitor           Visitor           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  experiment        ElementExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant           ElementVariant    @relation(fields: [variantId], references: [id])
  exposures         ElementExposure[]
  cartAttributions  CartElementAttribution[]
  checkoutAttributions CheckoutElementAttribution[]
  orderAttributions OrderElementAttribution[]

  @@unique([visitorId, experimentId])
  @@index([experimentId, variantId])
}

model ElementExposure {
  id           String            @id @default(uuid())
  eventId      String            @unique
  shopId       String
  slotId       String
  visitorId    String
  assignmentId String
  experimentId String
  variantId    String
  occurredAt   DateTime          @default(now())
  isInternal   Boolean           @default(false)
  shop         Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  slot         ElementSlot       @relation(fields: [slotId], references: [id], onDelete: Cascade)
  visitor      Visitor           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  assignment   ElementAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  experiment   ElementExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant      ElementVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([experimentId, variantId, occurredAt])
  @@index([visitorId, occurredAt])
}

model CartElementAttribution {
  id            String            @id @default(uuid())
  shopId        String
  cartToken     String
  visitorId     String
  assignmentId  String
  experimentId  String
  variantId     String
  slotId        String
  capturedAt    DateTime          @default(now())
  shop          Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  visitor       Visitor           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  assignment    ElementAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  experiment    ElementExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant       ElementVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  slot          ElementSlot       @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([cartToken, experimentId])
  @@index([experimentId, variantId, capturedAt])
  @@index([shopId, cartToken])
}

model CheckoutElementAttribution {
  id            String              @id @default(uuid())
  shopId        String
  checkoutToken String
  visitorId     String
  assignmentId  String
  experimentId  String
  variantId     String
  slotId        String
  capturedAt    DateTime            @default(now())
  shop          Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  checkout      CheckoutAttribution @relation(fields: [checkoutToken], references: [checkoutToken], onDelete: Cascade)
  visitor       Visitor             @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  assignment    ElementAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  experiment    ElementExperiment   @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant       ElementVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  slot          ElementSlot         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  orders        OrderElementAttribution[]

  @@unique([checkoutToken, experimentId])
  @@index([experimentId, variantId, capturedAt])
}

model OrderElementAttribution {
  id                    String                     @id @default(uuid())
  shopId                String
  orderAttributionId    String
  checkoutAttributionId String
  assignmentId          String
  experimentId          String
  variantId             String
  slotId                String
  attributedAt          DateTime                   @default(now())
  shop                  Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order                 OrderAttribution           @relation(fields: [orderAttributionId], references: [id], onDelete: Cascade)
  checkoutAttribution   CheckoutElementAttribution @relation(fields: [checkoutAttributionId], references: [id], onDelete: Cascade)
  assignment            ElementAssignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  experiment            ElementExperiment          @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant               ElementVariant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  slot                  ElementSlot                @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([orderAttributionId, experimentId])
  @@index([experimentId, variantId, attributedAt])
}

model Assignment {
  id           String   @id @default(uuid())
  visitorId    String
  experimentId String
  variantId    String
  assignedAt   DateTime @default(now())
  visitor      Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant      Variant  @relation(fields: [variantId], references: [id])

  @@unique([visitorId, experimentId])
  @@index([experimentId, variantId])
}

model Event {
  id            String   @id @default(uuid())
  shopId        String
  eventKey      String   @unique
  name          String
  source        String   @default("SYNTHETIC")
  occurredAt    DateTime
  receivedAt    DateTime @default(now())
  visitorId     String?
  funnelId      String?
  stepId        String?
  variantId     String?
  checkoutToken String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  deviceClass   String?
  payload       String   @default("{}")
  isTest        Boolean  @default(true)
  shop          Shop     @relation(fields: [shopId], references: [id])
  visitor       Visitor? @relation(fields: [visitorId], references: [id])
  funnel        Funnel?  @relation(fields: [funnelId], references: [id])
  step          Step?    @relation(fields: [stepId], references: [id])
  variant       Variant? @relation(fields: [variantId], references: [id])

  @@index([funnelId, stepId, variantId, occurredAt])
  @@index([checkoutToken])
  @@index([name, occurredAt, isTest])
}

model CheckoutAttribution {
  id            String   @id @default(uuid())
  shopId        String
  checkoutToken String   @unique
  visitorId     String?
  funnelId      String?
  lastStepId    String?
  lastVariantId String?
  startedAt     DateTime
  completedAt   DateTime?
  confidence    String   @default("MEDIUM")
  shop          Shop     @relation(fields: [shopId], references: [id])
  visitor       Visitor? @relation(fields: [visitorId], references: [id])
  orders        OrderAttribution[]
  elementAttributions CheckoutElementAttribution[]

  @@index([funnelId])
}

model OrderAttribution {
  id               String   @id @default(uuid())
  shopId           String
  shopifyOrderGid  String   @unique
  checkoutToken    String?
  funnelId         String?
  variantId        String?
  currency         String
  grossAmount      Float
  netRevenueAmount Float
  refundedAmount   Float    @default(0)
  status           String   @default("PAID")
  confidence       String
  isTest           Boolean  @default(true)
  discountCodes    String   @default("[]")
  popupAttributed  Boolean  @default(false)
  popupVisitorKey  String?
  popupSessionKey  String?
  popupVersion     String?
  popupCouponCode  String?
  popupPage        String?
  popupDevice      String?
  popupUtmSource   String?
  popupUtmMedium   String?
  popupUtmCampaign String?
  popupAttributionMethod String?
  paidAt           DateTime
  cancelledAt      DateTime?
  updatedAt        DateTime @updatedAt
  shop             Shop     @relation(fields: [shopId], references: [id])
  checkout         CheckoutAttribution? @relation(fields: [checkoutToken], references: [checkoutToken])
  elementAttributions OrderElementAttribution[]

  @@index([funnelId, variantId, paidAt])
  @@index([popupAttributed, popupVersion, paidAt])
  @@index([popupCouponCode, paidAt])
}

model ShopifyWebhookDelivery {
  id         String   @id @default(uuid())
  shopId     String
  webhookId  String   @unique
  topic      String
  receivedAt DateTime @default(now())
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, topic, receivedAt])
}

model SupportMailbox {
  id                    String   @id @default(uuid())
  shopId                String
  address               String
  provider              String   @default("NAMECHEAP_PRIVATE_EMAIL")
  connectionStatus      String   @default("CONFIGURED")
  automationMode        String   @default("DRAFT_ONLY")
  replyDelayMinutes     Int      @default(5)
  lastSyncAt            DateTime?
  lastAgentRunAt        DateTime?
  nextAgentRunAt        DateTime?
  lastAgentResult       String?
  lastScanCount         Int      @default(0)
  ignoredMessageCount   Int      @default(0)
  lastError             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  shop                  Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversations         SupportConversation[]

  @@unique([shopId, address])
  @@index([shopId, connectionStatus])
}

model SupportCustomer {
  id                    String   @id @default(uuid())
  shopId                String
  email                 String
  displayName           String?
  shopifyCustomerGid    String?
  lifetimeOrders        Int?
  riskLevel             String   @default("UNKNOWN")
  riskReasonsJson       String   @default("[]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  shop                  Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversations         SupportConversation[]

  @@unique([shopId, email])
  @@index([shopId, riskLevel])
}

model SupportConversation {
  id                    String   @id @default(uuid())
  shopId                String
  mailboxId             String
  customerId            String
  externalThreadKey     String
  subject               String
  status                String   @default("OPEN")
  priority              String   @default("NORMAL")
  topic                 String   @default("OTHER")
  audienceType          String   @default("UNKNOWN")
  triageStatus          String   @default("ACCEPTED")
  triageReason          String?
  language              String   @default("UNKNOWN")
  confidence            Float    @default(0)
  riskLevel             String   @default("UNKNOWN")
  assignedTo            String?
  escalationReason      String?
  summary               String?
  shopifyOrderGid       String?
  shopifyOrderName      String?
  nextActionAt          DateTime?
  lastCustomerMessageAt DateTime?
  lastAgentMessageAt    DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  shop                  Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  mailbox               SupportMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  customer              SupportCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages              SupportMessage[]
  drafts                SupportDraft[]
  evidence              SupportEvidenceEvent[]

  @@unique([shopId, externalThreadKey])
  @@index([shopId, status, updatedAt])
  @@index([shopId, nextActionAt])
}

model SupportMessage {
  id                String   @id @default(uuid())
  conversationId    String
  externalMessageId String   @unique
  direction         String
  fromAddress       String
  toAddressesJson   String   @default("[]")
  subject           String
  textBody          String
  sentAt            DateTime
  source            String   @default("IMAP")
  deliveryStatus    String   @default("RECEIVED")
  aiGenerated       Boolean  @default(false)
  triageClass       String   @default("REVIEW")
  triageScore       Float    @default(0)
  triageReasonsJson String   @default("[]")
  inReplyTo         String?
  referencesJson    String   @default("[]")
  attachmentsJson   String   @default("[]")
  createdAt         DateTime @default(now())
  conversation      SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@index([direction, sentAt])
}

model SupportDraft {
  id                String   @id @default(uuid())
  conversationId    String
  status            String   @default("PENDING_REVIEW")
  decision          String   @default("ESCALATE")
  replyText         String
  model             String?
  confidence        Float    @default(0)
  reason            String
  verifiedFactsJson String   @default("{}")
  policyFlagsJson   String   @default("[]")
  sendAfter         DateTime?
  claimedAt         DateTime?
  attemptCount      Int      @default(0)
  lastDeliveryError String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  conversation      SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status, createdAt])
  @@index([status, sendAfter])
}

model SupportEvidenceEvent {
  id                String   @id @default(uuid())
  conversationId    String
  kind              String
  source            String
  previousHash      String?
  contentHash       String
  payloadJson       String
  occurredAt        DateTime
  createdAt         DateTime @default(now())
  conversation      SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, occurredAt])
  @@index([kind, occurredAt])
}

model SupportVoiceExample {
  id                    String   @id @default(uuid())
  shopId                String
  inboundExternalId     String
  outboundExternalId    String
  topic                 String   @default("OTHER")
  customerMessage       String
  ownerReply            String
  qualityStatus         String   @default("LEARNED")
  createdAt             DateTime @default(now())
  shop                  Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, inboundExternalId, outboundExternalId])
  @@index([shopId, topic, qualityStatus])
}
