  <div class="novafunnel-mobile-upsells__rail" id="csMobileItems"></div>
</div>

{% if cart != empty %}
{%- liquid
  if cart.currency.iso_code == 'USD'
    assign ship_threshold = 5500
  else
    assign ship_threshold = 19900
  endif
  assign current_total = cart.total_price | default: 0
  if current_total >= ship_threshold
    assign ship_pct = 100
    assign ship_unlocked = true
  else
    assign ship_unlocked = false
    assign ship_diff = ship_threshold | minus: current_total
    assign ship_pct = current_total | times: 100 | divided_by: ship_threshold
    if ship_pct < 4 and current_total > 0
      assign ship_pct = 4
    endif
  endif
-%}
<div
  class="cart-drawer-cro-panel"
  data-free-ship-panel
  data-ship-threshold="{{ ship_threshold }}"
  data-ship-currency="{{ cart.currency.iso_code }}"
  style="margin: 12px 16px; padding: 14px; background: #FFFFFF; border: 1px solid #E7E1D7; border-radius: 14px; direction: rtl; text-align: right;"
>
  <div data-ship-copy style="font-size: 13px; font-weight: 800; color: {% if ship_unlocked %}#027A48{% else %}#17231E{% endif %}; margin-bottom: 8px; line-height: 1.4;">
    {%- if ship_unlocked -%}
      זכאית למשלוח חינם!
    {%- else -%}
      חסרים לך עוד ₪{{ ship_diff | money_without_currency }} למשלוח חינם
    {%- endif -%}
  </div>
  <div style="width: 100%; height: 10px; background: #E7E1D7; border-radius: 999px; overflow: hidden;">
    <div data-ship-fill style="width: {{ ship_pct }}%; height: 100%; background: {% if ship_unlocked %}#027A48{% else %}#C5A059{% endif %}; border-radius: 999px;"></div>
  </div>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #F4EFEA; font-size: 11px; font-weight: 700; color: #555; line-height: 1.35;">
    <span>5-14 ימי עסקים</span>
    <span>סליקה מאובטחת</span>
    <span>מוצר מקורי</span>
    <span>שירות לקוחות בעברית</span>
  </div>
</div>
{% endif %}


</div>
<!-- /.drawer__scroll -->
<div class="drawer__footer">
        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer">
            <summary>
              <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
            <cart-note class="cart__note field">
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawer-Note"
                class="text-area text-area--resize-vertical field__input"
                name="note"
                placeholder="{{ 'sections.cart.note' | t }}"
              >{{ cart.note }}</textarea>
            </cart-note>
          </details>
        {%- endif -%}

        <!-- Start blocks -->
        <!-- Subtotals moved below bumps -->

        {%- comment -%}
        <div class="cart-drawer__footer cart-drawer__footer--legacy" style="display:none;" {{ block.shopify_attributes }}>
          <small class="tax-note caption-large rte" style="display:block;text-align:center;margin:2px 0 10px;line-height:1.7;color:#8A8A8A;">
            {%- if cart.duties_included and cart.taxes_included -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included == false and cart.taxes_included -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included and cart.taxes_included == false -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- endif -%}
          </small>
        </div>
        {%- endcomment -%}

        <!-- CTAs -->

        
        
        <!-- Subtotals — pinned footer, compact horizontal -->
        <div class="cart-drawer__footer" {{ block.shopify_attributes }}>
          {%- liquid
            assign novafunnel_reference_total = 0
            for savings_item in cart.items
              assign savings_reference_line = savings_item.original_line_price

              if savings_item.product.handle == 'novahair-funnel-internal'
                assign savings_bundle_config = savings_item.properties['_NOVASALE_CONFIG'] | default: savings_item.variant.sku
                assign savings_bundle_parts = savings_bundle_config | split: '-'
                assign savings_bundle_size = savings_item.properties['_BUNDLE_SIZE'] | default: savings_bundle_parts[1]
                case savings_bundle_size
                  when '2'
                    assign savings_reference_line = 37980 | times: savings_item.quantity
                  when '4'
                    assign savings_reference_line = 75800 | times: savings_item.quantity
                  when '6'
                    assign savings_reference_line = 113700 | times: savings_item.quantity
                endcase
              else
                case savings_item.variant_id
                  when 50459892580647
                    assign savings_reference_line = 11999 | times: savings_item.quantity
                  when 51885840072999
                    assign savings_reference_line = 3990 | times: savings_item.quantity
                  when 51885840400679
                    assign savings_reference_line = 3990 | times: savings_item.quantity
                endcase
              endif

              assign novafunnel_reference_total = novafunnel_reference_total | plus: savings_reference_line
            endfor
            assign novafunnel_paid_total = cart.total_price | default: 0
            assign novafunnel_savings = novafunnel_reference_total | minus: novafunnel_paid_total
            if novafunnel_savings < 0
              assign novafunnel_savings = 0
            endif
            assign novafunnel_savings_pct = 0
            if novafunnel_savings > 0 and novafunnel_reference_total > 0
              assign novafunnel_savings_pct = novafunnel_savings | times: 100.0 | divided_by: novafunnel_reference_total | round
            endif
          -%}
