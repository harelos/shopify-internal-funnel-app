                              style="width:64px;height:64px;object-fit:cover;border-radius:10px;border:1px solid #EFE9E1;background:#FAF8F5;"
                            >
                          {% endif %}
                        </td>

                        <td class="cart-item__details" role="cell" headers="CartDrawer-ColumnProduct">
                          {%- if settings.show_vendor -%}
                            <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
                          {%- endif -%}

                          {%- if is_novahair_sales_bundle -%}
                            <div class="cart-item__name h4 break novafunnel-cart-title" style="font-size:14px;line-height:1.35;font-weight:800;">
                              {%- if customer_display_title != blank -%}
                                {{ customer_display_title | escape }}
                              {%- else -%}
                                NovaHair — מארז {{ nh_sales_qty }} בקבוקים
                              {%- endif -%}
                            </div>
                            {%- assign nh_shade_summary = item.properties['בחירת גוונים'] | default: '' -%}
                            {%- assign nh_shade_parts = nh_shade_summary | split: ' + ' -%}
                            {%- if nh_shade_summary != blank -%}
                              <div class="novafunnel-config">
                                <div class="novafunnel-config-head">
                                  <span class="novafunnel-config-label">הרכב גוונים</span>
                                  <button type="button" class="novafunnel-change" data-novafunnel-edit-selection>שינוי</button>
                                </div>
                                <div class="novafunnel-config-chips" aria-label="הרכב הגוונים שנבחר">
                                  {%- for shade_part in nh_shade_parts -%}
                                    <span class="novafunnel-config-chip">{{ shade_part | strip | escape }}</span>
                                  {%- endfor -%}
                                </div>
                              </div>
                            {%- endif -%}
                          {%- else -%}
                            <a href="{{ item.url }}" class="cart-item__name h4 break" style="font-size:14px;line-height:1.35;font-weight:800;">
                              {%- if is_novahair_bundle -%}
                                NOVAHAIR™ — ערכת צביעה ביתית לשיער
                              {%- elsif is_elastic_bundle -%}
                                מסיכת קולגן לילה ElasticDream™
                              {%- else -%}
                                {{- item.product.title | escape -}}
                              {%- endif -%}
                            </a>
                          {%- endif -%}

                          {%- comment -%} Clean variant line — no internal SKUs exposed {%- endcomment -%}
                          {%- if is_elastic_bundle -%}
                            <div class="product-option" style="font-size:12.5px;color:#55625D;margin-top:2px;line-height:1.4;">
                              {{ item.variant.title }}
                            </div>
                          {%- endif -%}

                          {%- if item.product.has_only_default_variant == false
                            and is_novahair_bundle == false
                            and is_novahair_sales_bundle == false
                            and is_elastic_bundle == false
                            or item.properties.size != 0
                            or item.selling_plan_allocation != null
                          -%}
                            <dl style="margin:4px 0 0;">
                              {%- if item.product.has_only_default_variant == false
                                and is_novahair_bundle == false
                                and is_novahair_sales_bundle == false
                                and is_elastic_bundle == false
                              -%}
                                {%- for option in item.options_with_values -%}
                                  <div class="product-option" style="font-size:12.5px;color:#55625D;line-height:1.4;">
                                    <dt style="display:inline;">{{ option.name }}:</dt>
                                    <dd style="display:inline;margin:0;">
                                      {{ option.value -}}
                                      {%- unless forloop.last %}, {% endunless %}
                                    </dd>
                                  </div>
                                {%- endfor -%}
                              {%- endif -%}

{%- for property in item.properties -%}
  {%- assign property_first_char = property.first | slice: 0 -%}
  {%- assign hide_public_property = false -%}
  {%- if property.first contains 'TIGERA' or property.first contains 'הרכב החבילה' -%}
    {%- assign hide_public_property = true -%}
  {%- endif -%}
  {%- if is_novahair_sales_bundle and property.first == 'בחירת גוונים' -%}
    {%- assign hide_public_property = true -%}
  {%- endif -%}
  {%- if property.last != blank and property_first_char != '_' and hide_public_property == false -%}
    <div class="product-option" style="display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-size:12.5px;background:#FFFDF9;padding:6px 10px;border-radius:8px;border:1px solid #F0EAE0;margin-top:5px;line-height:1.45;">
      <span style="font-weight:700;color:#8C6D2B;flex-shrink:0;">{{ property.first }}</span>
      <span style="color:#17231E;font-weight:600;text-align:left;word-break:break-word;">{{ property.last }}</span>
    </div>
  {%- endif -%}
{%- endfor -%}

                            </dl>

                            <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}

                          {%- unless is_novahair_sales_bundle or novafunnel_cross_sell_image != blank -%}
                            <ul
                              class="discounts list-unstyled"
                              role="list"
                              aria-label="{{ 'customer.order.discount' | t }}"
                            >
                              {%- for discount in item.line_level_discount_allocations -%}
                                <li class="discounts__discount">
                                  {{- 'icon-discount.svg' | inline_asset_content -}}
                                  {{ discount.discount_application.title }}
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endunless -%}
                        </td>

                        <td class="cart-item__totals right" role="cell" headers="CartDrawer-ColumnTotal">
                          {%- render 'loading-spinner' -%}
                          <div class="cart-item__price-wrapper">
                            {%- liquid
                              assign line_discount_total = 0
                              for allocation in item.discount_allocations
                                assign line_discount_total = line_discount_total | plus: allocation.amount
                              endfor
                              assign line_pay = item.original_line_price | minus: line_discount_total
                              if line_pay < 0 or line_discount_total == 0
                                assign line_pay = item.final_line_price
                              endif
                              if cart.items.size == 1 and cart.total_discount > 0
                                assign line_pay = cart.total_price
                              endif
                            -%}
                            {%- if item.original_line_price > line_pay -%}
                              <div class="cart-item__discounted-prices" style="display:flex;flex-direction:column;align-items:flex-start;gap:2px;">
                                <s class="cart-item__old-price" style="font-size:13px;font-weight:600;color:#8A8A8A;">₪{{ item.original_line_price | money_without_currency }}</s>
                                <span class="price price--end" style="font-size:18px;font-weight:800;color:#17231E;">₪{{ line_pay | money_without_currency }}</span>
                              </div>
                            {%- else -%}
                              <span class="price price--end" style="font-size:18px;font-weight:800;color:#17231E;">₪{{ line_pay | money_without_currency }}</span>
                            {%- endif -%}

                            {%- if item.variant.available and item.unit_price_measurement -%}
                              {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                            {%- endif -%}
                          </div>
                        </td>
                        {%- liquid
                          assign has_qty_rules = false
                          if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                            assign has_qty_rules = true
                          endif

                          assign has_vol_pricing = false
                          if item.variant.quantity_price_breaks.size > 0
                            assign has_vol_pricing = true
                          endif
                        -%}
                        <td
                          class="cart-item__quantity {% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}"
                          role="cell"
                          headers="CartDrawer-ColumnQuantity"
                        >
                          <quantity-popover>
                            <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                              <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                                <quantity-input class="quantity cart-quantity">
                                  <button
                                    class="quantity__button"
                                    name="minus"
                                    type="button"
                                    {% if item.instructions and item.instructions.can_update_quantity == false %}
                                      disabled
                                    {% endif %}
                                  >
                                    <span class="visually-hidden">
                                      {{-
                                        'products.product.quantity.decrease'
                                        | t: product: customer_aria_title
                                        | escape
                                      -}}
                                    </span>
                                    <span class="svg-wrapper">
                                      {{- 'icon-minus.svg' | inline_asset_content -}}
                                    </span>
                                  </button>
                                  <input
                                    class="quantity__input"
                                    type="number"
                                    data-quantity-variant-id="{{ item.variant.id }}"
                                    name="updates[{{ item.key }}]"
                                    value="{{ item.quantity }}"
                                    {% # theme-check-disable %}
                                    data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                    min="0"
                                    data-min="0"
                                    {% if item.variant.quantity_rule.max != null and is_novahair_sales_bundle == false %}
                                      max="{{ item.variant.quantity_rule.max }}"
                                    {% endif %}
                                    step="{{ item.variant.quantity_rule.increment }}"
                                    {% # theme-check-enable %}
                                    aria-label="{{ 'products.product.quantity.input_label' | t: product: customer_aria_title | escape }}"
                                    id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                    data-index="{{ item.index | plus: 1 }}"
                                    {% if is_novahair_sales_bundle %}
                                      readonly
                                      max="1"
                                    {% endif %}
                                    {% if item.instructions and item.instructions.can_update_quantity == false %}
                                      disabled
                                    {% endif %}
                                  >
                                  <button
                                    class="quantity__button"
                                    name="plus"
                                    type="button"
                                    {% if is_novahair_sales_bundle or item.instructions and item.instructions.can_update_quantity == false %}
                                      disabled
                                    {% endif %}
                                  >
                                    <span class="visually-hidden">
                                      {{-
                                        'products.product.quantity.increase'
                                        | t: product: customer_aria_title
                                        | escape
                                      -}}
                                    </span>
                                    <span class="svg-wrapper">
                                      {{- 'icon-plus.svg' | inline_asset_content -}}
                                    </span>
                                  </button>
                                </quantity-input>
                              </div>
                              <cart-remove-button
                                id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                              >
                                <button
                                  type="button"
                                  class="button button--tertiary cart-remove-button"
                                  aria-label="{{ 'sections.cart.remove_title' | t: title: customer_aria_title | escape }}"
                                  data-variant-id="{{ item.variant.id }}"
                                  {% if item.instructions and item.instructions.can_remove == false %}
                                    class="hidden"
                                  {% endif %}
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-remove.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                              </cart-remove-button>
                            </div>
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary"
                                aria-expanded="false"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-info.svg' | inline_asset_content -}}
                                </span>
                                <span>
                                  {%- if has_vol_pricing -%}
                                    {{ 'products.product.volume_pricing.note' | t }}
                                  {%- elsif has_qty_rules -%}
                                    {{ 'products.product.quantity.note' | t }}
                                  {%- endif -%}
                                </span>
                              </button>
                            {%- endif -%}
                            {%- if has_vol_pricing or has_qty_rules -%}
                              <div
                                class="cart-items__info global-settings-popup quantity-popover__info"
                                tabindex="-1"
                                hidden
                              >
                                {%- if has_qty_rules == false -%}
                                  <span class="volume-pricing-label caption">
                                    {{- 'products.product.volume_pricing.title' | t -}}
                                  </span>
                                {%- endif -%}
                                <div class="quantity__rules caption">
                                  {%- if item.variant.quantity_rule.increment > 1 -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.multiples_of'
                                        | t: quantity: item.variant.quantity_rule.increment
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.min > 1 -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.min_of'
                                        | t: quantity: item.variant.quantity_rule.min
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.max != null -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.max_of'
                                        | t: quantity: item.variant.quantity_rule.max
                                      -}}
                                    </span>
                                  {%- endif -%}
                                </div>
                                <button
                                  class="button-close button button--tertiary"
                                  type="button"
                                  aria-label="{{ 'accessibility.close' | t }}"
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-close.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                                {%- if item.variant.quantity_price_breaks.size > 0 -%}
                                  <volume-pricing class="parent-display">
                                    <ul class="list-unstyled">
                                      <li>
                                        <span>{{ item.variant.quantity_rule.min }}+</span>
                                        <span>₪{{ item.variant.price | money_without_currency }}/ea</span>
                                      </li>
                                      {%- for price_break in item.variant.quantity_price_breaks -%}
                                        <li>
                                          <span>
                                            {{- price_break.minimum_quantity -}}
                                            <span aria-hidden="true">+</span></span
                                          >
                                          <span>₪{{ price_break.price | money_without_currency }}/ea</span>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  </volume-pricing>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                            <div
                              id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                              class="cart-item__error"
                              role="alert"
                            >
                              <small class="cart-item__error-text"></small>
                              <span class="svg-wrapper">
                                {{- 'icon-error.svg' | inline_asset_content -}}
                              </span>
                            </div>
                          </quantity-popover>
                        </td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
      </cart-drawer-items>

{%- assign novafunnel_has_sales_bundle = false -%}
{%- assign novafunnel_bump_count = 0 -%}
{%- assign novafunnel_bump_total = 0 -%}
{%- for drawer_item in cart.items -%}
  {%- if drawer_item.product.handle == 'novahair-funnel-internal' -%}
    {%- assign novafunnel_has_sales_bundle = true -%}
  {%- endif -%}
  {%- if drawer_item.variant_id == 51878069535015 or drawer_item.variant_id == 51880636875047 or drawer_item.variant_id == 51880681472295 -%}
    {%- assign novafunnel_bump_count = novafunnel_bump_count | plus: drawer_item.quantity -%}
    {%- assign novafunnel_bump_total = novafunnel_bump_total | plus: drawer_item.final_line_price -%}
