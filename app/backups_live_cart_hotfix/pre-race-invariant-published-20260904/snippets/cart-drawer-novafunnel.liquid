<style>
  cart-drawer {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 999999;
    display: flex;
    justify-content: flex-start; /* RTL: drawer comes from right/left */
    transition: opacity 0.18s ease, visibility 0.18s ease;
  }
  cart-drawer:not(.active) {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  cart-drawer.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .cart-drawer__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(23, 35, 30, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .drawer__inner {
    position: relative;
    width: 440px;
    max-width: 90vw;
    height: 100%;
    background: #FFFFFF !important;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    z-index: 2;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    direction: rtl;
    text-align: right;
  }
  @media (max-width: 749px) {
    .drawer__inner { width: 100vw !important; max-width: 100vw !important; }
    .cart-drawer__overlay {
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
  }
  .drawer__header {
    padding: 16px 20px;
    border-bottom: 1px solid #E7E1D7;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .drawer__heading {
    font-size: 18px;
    font-weight: 800;
    color: #17231E;
    margin: 0;
  }
  .drawer__close {
    background: transparent;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: #17231E;
  }
  .drawer__body {
    flex: 1;
    padding: 16px 20px;
    overflow-y: auto;
  }
  .drawer__footer {
    padding: 16px 20px;
    border-top: 1px solid #E7E1D7;
    background: #FAF8F5;
  }
</style>
