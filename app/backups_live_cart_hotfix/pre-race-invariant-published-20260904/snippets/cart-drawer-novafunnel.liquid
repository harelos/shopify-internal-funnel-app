          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                <table class="cart-items" role="table">
                  <thead role="rowgroup" style="display: none;">
                    <tr role="row">
                      <th id="CartDrawer-ColumnProductImage" role="columnheader">
                        <span class="visually-hidden">{{ 'sections.cart.headings.image' | t }}</span>
                      </th>
                      <th
                        id="CartDrawer-ColumnProduct"
                        class="caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.product' | t }}
                      </th>
                      <th
                        id="CartDrawer-ColumnTotal"
                        class="right caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.total' | t }}
                      </th>
                      <th id="CartDrawer-ColumnQuantity" role="columnheader">
                        <span class="visually-hidden">{{ 'sections.cart.headings.quantity' | t }}</span>
                      </th>
                    </tr>
                  </thead>

                  <tbody role="rowgroup" data-novafunnel-cart-rows>
                    {%- for item in cart.items -%}
                      <tr
                        id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                        class="cart-item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}{% if item.variant.id == 51878069535015 or item.variant.id == 51880636875047 or item.variant.id == 51880681472295 or item.variant.id == 50459892580647 or item.variant.id == 51885840072999 or item.variant.id == 51885840138535 or item.variant.id == 51885840400679 %} novafunnel-addon-item{% endif %}{% if item.variant.id == 51878069535015 or item.variant.id == 51880636875047 or item.variant.id == 51880681472295 %} novafunnel-bump-item{% endif %}"
                        data-line-key="{{ item.key }}"
                        data-product-id="{{ item.product.id }}"
                        data-variant-id="{{ item.variant.id }}"
                        data-novafunnel-main-offer="{% if item.product.handle == 'novahair-funnel-internal' %}true{% else %}false{% endif %}"
                        data-novafunnel-order="{% if item.product.handle == 'novahair-funnel-internal' %}0{% elsif item.properties['_NOVAFUNNEL_ROLE'] == 'CROSS_SELL' or item.variant.id == 50459892580647 or item.variant.id == 51885840072999 or item.variant.id == 51885840138535 or item.variant.id == 51885840400679 %}1{% else %}2{% endif %}"
                        role="row"
                        {% if item.parent_relationship.parent != null %}
                          aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                        {% endif %}
                      >
                        {%- liquid
                          assign is_novahair_bundle = false
                          assign is_novahair_sales_bundle = false
                          assign is_elastic_bundle = false
                          assign customer_display_title = item.properties['_CART_DISPLAY_TITLE'] | default: ''
                          if item.product.handle == 'tigera-color-internal-bundle'
                            assign is_novahair_bundle = true
                          endif
                          if item.product.handle == 'novahair-funnel-internal'
                            assign is_novahair_sales_bundle = true
                            assign nh_sales_cfg = item.properties['_NOVASALE_CONFIG'] | default: item.variant.sku
                            assign nh_sales_parts = nh_sales_cfg | split: '-'
                            assign nh_sales_qty = item.properties['_BUNDLE_SIZE']
                            if nh_sales_qty == blank
                              assign nh_sales_qty = nh_sales_parts[1]
                            endif
                          endif
                          if item.product.handle == 'elastic-dream-internal-bundles'
                            assign is_elastic_bundle = true
                          endif
                          assign novafunnel_cross_sell_image = ''
                          case item.variant.id
                            when 50459892580647
                              assign novafunnel_cross_sell_image = 'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/859a4808-129b-4821-8588-67ecfaefd97d.jpg?v=1758896863'
                            when 51885840072999
                              assign novafunnel_cross_sell_image = 'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/3c8c2338-1207-454e-a4d7-dfd7743f28c6.jpg?v=1786967692'
                            when 51885840138535
                              assign novafunnel_cross_sell_image = 'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/d08ade7c-b095-4092-b83d-dc9b6b5784c1.jpg?v=1786967695'
                            when 51885840400679
                              assign novafunnel_cross_sell_image = 'https://cdn.shopify.com/s/files/1/0719/2628/4583/files/d0e60057-38b4-4066-a555-8a5f6b4c6609.jpg?v=1786967702'
                          endcase
                          assign customer_aria_title = item.product.title
                          if is_novahair_sales_bundle
                            if customer_display_title != blank
                              assign customer_aria_title = customer_display_title
                            else
                              capture customer_aria_title
                                echo 'NovaHair — מארז '
                                echo nh_sales_qty
                                echo ' בקבוקים'
                              endcapture
                            endif
                          endif
                        -%}
                        <td
