# Local/runtime configuration. Never commit real credentials.
APP_PORT=3000
APP_URL=https://replace-with-public-https-host
SHOP_DOMAIN=example.myshopify.com
ALLOWED_SHOP_DOMAIN=example.myshopify.com
# PostgreSQL only. In Railway, use the generated Postgres DATABASE_URL.
DATABASE_URL=postgresql://user:password@localhost:5432/shopify_funnel_builder?schema=public
ENABLE_DEMO_SEED=false
ANALYTICS_MODE=TEST
ANALYTICS_ALLOW_TEST_QUERY=false
SHOPIFY_LIVE_CONNECT=false
SHOPIFY_REQUIRE_AUTH=false
# Interim owner gate for a hosted deployment, used until SHOPIFY_REQUIRE_AUTH=true
# makes App Bridge session tokens the real boundary. Leave both blank locally:
# unset credentials make the gate a no-op so the local preview keeps working.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=
SHOPIFY_DISTRIBUTION=custom
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders,read_reports,read_pixels,read_customer_events,write_app_proxy,write_pixels
SHOPIFY_ACCESS_TOKEN=
# Dedicated Partner-app token approved for protected Shopify Customer data.
SHOPIFY_PII_TOKEN=
SHOPIFY_APP_PROXY_URL=https://replace-with-public-https-host
SHOPIFY_APP_PROXY_PATH=/apps/funnels
# Webhook secret is server-only. Do not enable webhook receivers without HMAC validation.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_PIXEL_INGEST_ENABLED=false
