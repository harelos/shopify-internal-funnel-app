# Local/runtime configuration. Never commit real credentials.
APP_PORT=3000
APP_URL=https://replace-with-public-https-host
SHOP_DOMAIN=example.myshopify.com
ALLOWED_SHOP_DOMAIN=example.myshopify.com
# The current local slice uses Prisma SQLite. Do not point this at Railway until
# the Prisma provider is migrated to PostgreSQL and a non-destructive migration
# has been reviewed.
DATABASE_URL=file:./dev.db
ENABLE_DEMO_SEED=false
ANALYTICS_MODE=TEST
ANALYTICS_ALLOW_TEST_QUERY=false
SHOPIFY_LIVE_CONNECT=false
SHOPIFY_REQUIRE_AUTH=false
SHOPIFY_DISTRIBUTION=custom
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders,read_reports,read_pixels,read_customer_events,write_app_proxy,write_pixels
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_APP_PROXY_URL=https://replace-with-public-https-host
SHOPIFY_APP_PROXY_PATH=/apps/funnels
# Webhook secret is server-only. Do not enable webhook receivers without HMAC validation.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_PIXEL_INGEST_ENABLED=false

# Public bot QA. Disabled by default. When enabled, /qa/bot/* bypasses Shopify
# embedded-session auth but requires BOT_PUBLIC_QA_TOKEN. Keep this token server-only.
# Public QA must remain read-only and storefrontEnabled=false.
BOT_PUBLIC_QA_MODE=false
BOT_PUBLIC_QA_TOKEN=
