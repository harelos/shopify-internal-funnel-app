# Local/runtime configuration. Never commit real credentials.
APP_PORT=3000
APP_URL=https://replace-with-public-https-host
SHOP_DOMAIN=example.myshopify.com
ALLOWED_SHOP_DOMAIN=example.myshopify.com
# The current local slice uses Prisma SQLite. Do not point this at Railway until
# the Prisma provider is migrated to PostgreSQL and a non-destructive migration
# has been reviewed.
DATABASE_URL=file:./dev.db
ENABLE_DEMO_SEED=false
ANALYTICS_MODE=TEST
ANALYTICS_ALLOW_TEST_QUERY=false
SHOPIFY_LIVE_CONNECT=false
SHOPIFY_REQUIRE_AUTH=false
SHOPIFY_DISTRIBUTION=custom
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders,read_reports,read_pixels,read_customer_events,write_app_proxy,write_pixels
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_APP_PROXY_URL=https://replace-with-public-https-host
SHOPIFY_APP_PROXY_PATH=/apps/funnels
# Webhook secret is server-only. Do not enable webhook receivers without HMAC validation.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_PIXEL_INGEST_ENABLED=false

# Customer Support Agent — Phase 1 staging boundary.
# Phase 1 is READ ONLY. No SMTP, refunds, cancellations, reships, discounts or Shopify mutations.
SUPPORT_STAGING_ENABLED=false
SUPPORT_SYNC_SOURCE=fixture
SUPPORT_MAILBOX_ADDRESS=support@example.test
SUPPORT_SYNC_LIMIT=250

# Real mailbox gate. BOTH SUPPORT_STAGING_ENABLED=true and SUPPORT_IMAP_READ_ENABLED=true
# are required before the app can connect to IMAP.
SUPPORT_IMAP_READ_ENABLED=false
SUPPORT_IMAP_HOST=mail.privateemail.com
SUPPORT_IMAP_PORT=993
SUPPORT_IMAP_SECURE=true
SUPPORT_IMAP_USERNAME=
SUPPORT_IMAP_PASSWORD=
SUPPORT_IMAP_MAILBOX=INBOX
# Messages larger than this are skipped rather than loaded into the staging process.
SUPPORT_IMAP_MAX_SOURCE_BYTES=2097152

# Optional Shopify order support context. This is a separate read-only staging gate.
# SHOPIFY_LIVE_CONNECT must also be enabled and the installed app must retain read_orders.
# Returned support context is reduced and not persisted by the support module.
SUPPORT_SHOPIFY_LOOKUP_ENABLED=false
SUPPORT_SHOPIFY_ORDER_LIMIT=5

# Optional MINIMAL Shopify customer identity context. Keep disabled unless needed.
# This additionally requires Shopify read_customers authorization/protected-customer-data approval.
# The adapter asks only for id, first name, last name and exact matched email; it does not ask for
# phone/address/tags/spend/marketing/tax fields and does not persist the customer response.
# Do not add read_customers to SHOPIFY_SCOPES casually; enable it only through an intentional app permission change.
SUPPORT_SHOPIFY_CUSTOMER_LOOKUP_ENABLED=false

# Versioned internal knowledge pack. The loader fails closed unless the pack itself
# has status=APPROVED and every fact used by the agent is explicitly state=KNOWN.
# Keep this disabled until a real store policy/product pack has been reviewed.
SUPPORT_KNOWLEDGE_ENABLED=false
SUPPORT_KNOWLEDGE_PACK_PATH=
