# Local/runtime configuration. Never commit real credentials.
APP_PORT=3000
APP_URL=https://replace-with-public-https-host
SHOP_DOMAIN=example.myshopify.com
ALLOWED_SHOP_DOMAIN=example.myshopify.com
# The current local slice uses Prisma SQLite. Do not point this at Railway until
# the Prisma provider is migrated to PostgreSQL and a non-destructive migration
# has been reviewed.
DATABASE_URL=file:./dev.db
ENABLE_DEMO_SEED=false
ANALYTICS_MODE=TEST
ANALYTICS_ALLOW_TEST_QUERY=false
SHOPIFY_LIVE_CONNECT=false
SHOPIFY_REQUIRE_AUTH=false
SHOPIFY_DISTRIBUTION=custom
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders,read_reports,read_pixels,read_customer_events,write_app_proxy,write_pixels
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_APP_PROXY_URL=https://replace-with-public-https-host
SHOPIFY_APP_PROXY_PATH=/apps/funnels
# Webhook secret is server-only. Do not enable webhook receivers without HMAC validation.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_PIXEL_INGEST_ENABLED=false

# Qualified Commerce Traffic baseline.
QUALIFIED_COMMERCE_TARGET_COUNTRIES=IL

# Popup Platform — staging only.
# Keep the kill switch true until an isolated storefront runtime has passed full QA.
POPUP_STAGING_ENABLED=false
POPUP_STAGING_EVENT_INGEST=false
POPUP_CONTEXT_COLLECTOR_ENABLED=false
POPUP_ATTRIBUTION_ENABLED=false
POPUP_KILL_SWITCH=true
# 10% no-popup holdout by default. Range is clamped to 0..5000 basis points.
POPUP_HOLDOUT_BASIS_POINTS=1000
# Signed popup assignment can be linked to checkout for up to 14 days in staging.
POPUP_ATTRIBUTION_WINDOW_DAYS=14
# Required before staging event ingestion/attribution hashing can be enabled. Use a secret manager value.
POPUP_EVENT_HASH_PEPPER=
# Required before the public staging context API can issue signed visitor/session identity.
# Use a distinct secret manager value >= 32 characters; never commit a real value.
POPUP_SESSION_SECRET=
# Comma-separated exact origins allowed to call the context API. The SHOP_DOMAIN
# myshopify origin is also included automatically.
POPUP_ALLOWED_STOREFRONT_ORIGINS=
# Enables x-tiger-test-country only outside NODE_ENV=production.
POPUP_ALLOW_TEST_CONTEXT=false
