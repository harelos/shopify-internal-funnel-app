    "body_html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700;800;900&amp;display=swap&amp;subset=hebrew\" rel=\"stylesheet\">\n<style>\n.nova, .nova *, .nova *::before, .nova *::after {\n  box-sizing: border-box;\n  font-family: 'Open Sans', 'Arial Hebrew', Arial, system-ui, -apple-system, sans-serif !important;\n  direction: rtl;\n}\n.nova {\n  --ink: #2B2420;\n  --ink-soft: #5C5048;\n  --ink-mute: #8B7E73;\n  --cream: #F7F1EA;\n  --cream-2: #EFE5D8;\n  --cream-3: #E4D6C4;\n  --bronze: #D36D37;\n  --bronze-dk: #B85F24;\n  --bronze-soft: #F6E3D4;\n  --gold: #C29A4A;\n  --green: #54856C;\n  margin: 0;\n  background: var(--cream);\n  color: var(--ink);\n  font-size: 17px;\n  line-height: 1.7;\n  overflow-x: hidden;\n}\n.nova img { max-width: 100%; display: block; height: auto; }\n.nova .wrap { max-width: 740px; margin: 0 auto; padding: 0 18px; }\n.nova h1, .nova h2, .nova h3 { margin: 0 0 .5em; line-height: 1.25; font-weight: 800; text-align: right; color: #171717; }\n.nova p { margin: 0 0 1.1em; text-align: right; line-height: 1.75; color: #3D3631; }\n\n/* Editorial Masthead */\n.nova .editorial-masthead {\n  background: #FFFFFF;\n  border-bottom: 1px solid #E8DFD5;\n  padding: 16px 18px;\n  text-align: center;\n}\n.nova .editorial-masthead__brand {\n  font-size: 20px;\n  font-weight: 900;\n  letter-spacing: 0.08em;\n  color: #1A1A1A;\n  text-transform: uppercase;\n  margin: 0;\n}\n.nova .editorial-masthead__sub {\n  font-size: 12px;\n  color: #8A776A;\n  font-weight: 600;\n  margin-top: 2px;\n}\n\n/* Article Sub-nav & Disclosure */\n.nova .article-meta-nav {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n  padding: 12px 0 18px;\n  border-bottom: 1px solid #EADFD4;\n  margin-bottom: 24px;\n}\n.nova .article-breadcrumb {\n  font-size: 12px;\n  color: #6B625B;\n  font-weight: 500;\n  text-align: right;\n}\n.nova .article-disclosure {\n  font-size: 11px;\n  font-weight: 500;\n  color: #8A776A;\n  text-align: left;\n}\n\n/* H1 Headline */\n.nova .article-title {\n  text-align: right;\n  color: #171717;\n  font-weight: 800;\n  font-size: clamp(28px, 4.5vw, 42px);\n  line-height: 1.22;\n  margin: 0 0 20px;\n}\n\n/* Author / Metadata Row */\n.nova .article-author {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  direction: rtl;\n  text-align: right;\n  padding: 14px 18px;\n  background: #FFFFFF;\n  border: 1px solid #E8DFD5;\n  border-radius: 12px;\n  margin-bottom: 22px;\n}\n.nova .article-author__avatar {\n  width: 46px;\n  height: 46px;\n  border-radius: 50%;\n  overflow: hidden;\n  flex: 0 0 46px;\n  border: 2px solid #E8DFD5;\n  background: #EFE5D8;\n}\n.nova .article-author__avatar img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: 48% 30%;\n}\n.nova .article-author__info {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n.nova .article-author__name {\n  font-size: 14px;\n  font-weight: 700;\n  color: #1A1A1A;\n}\n.nova .article-author__date {\n  font-size: 12px;\n  color: #7A6F66;\n}\n.nova .article-author__rating {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12px;\n  font-weight: 700;\n  color: #2B2420;\n  margin-top: 2px;\n}\n\n/* Main Hero Image (Batch 8 / Asset 9) */\n.nova .article-hero {\n  width: 100%;\n  max-width: 880px;\n  margin: 22px auto 28px;\n  padding: 0;\n}\n.nova .article-hero img {\n  display: block;\n  width: 100%;\n  height: auto;\n  border-radius: 12px;\n  box-shadow: 0 4px 20px rgba(43,36,32,.06);\n}\n.nova .article-hero figcaption {\n  margin-top: 8px;\n  color: #7A6F67;\n  font-size: 13px;\n  line-height: 1.55;\n  text-align: right;\n  direction: rtl;\n}\n\n/* Reusable Editorial Article Visual & Captions */\n.nova .article-visual {\n  width: 100%;\n  max-width: 760px;\n  margin: 18px auto 24px;\n  padding: 0;\n}\n.nova .article-visual img {\n  display: block;\n  width: 100%;\n  height: auto;\n  border-radius: 12px;\n  box-shadow: 0 4px 18px rgba(43,36,32,.04);\n}\n.nova .article-visual figcaption {\n  margin-top: 8px;\n  color: #7A6F67;\n  font-size: 13px;\n  line-height: 1.55;\n  text-align: right;\n  direction: rtl;\n}\n\n/* Opening Lead with Orange Accent */\n.nova .article-lead {\n  margin: 24px 0 32px;\n  padding-right: 18px;\n  border-right: 4px solid var(--bronze);\n  color: #36312E;\n  font-size: 18px;\n  font-weight: 500;\n  line-height: 1.75;\n  text-align: right;\n}\n.nova .article-lead p:last-child { margin-bottom: 0; }\n\n/* Reason Sections */\n.nova .reason {\n  background: #FFFFFF;\n  border: 1px solid var(--cream-3);\n  border-radius: 16px;\n  padding: 26px 24px;\n  margin: 0 0 28px;\n  box-shadow: 0 4px 16px rgba(43,36,32,.03);\n}\n.nova .badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  background: var(--bronze);\n  color: #FFFFFF;\n  font-weight: 800;\n  font-size: 1rem;\n  margin-bottom: 12px;\n}\n.nova .badge-bonus {\n  width: auto;\n  border-radius: 999px;\n  padding: 4px 12px;\n  font-size: 0.85rem;\n  background: var(--ink);\n}\n.nova .sci {\n  display: block;\n  font-size: 0.84rem;\n  color: #7A6F66;\n  border-top: 1px solid #EFE5D8;\n  padding-top: 10px;\n  margin-top: 12px;\n  font-weight: 600;\n}\n\n/* ============================================================\n   PROGRESSIVE EDITORIAL CTAS (NO WHITE CARDS / NO HEAVY ORANGE)\n   ============================================================ */\n\n/* CTA 1: Soft Editorial Text Link */\n.nova .editorial-cta--soft {\n  margin: 26px 0 34px;\n  text-align: right;\n}\n.nova .editorial-cta__intro {\n  margin: 0 0 6px;\n  color: #4A4038;\n  font-size: 14px;\n  line-height: 1.5;\n  font-weight: 500;\n}\n.nova .editorial-cta__link {\n  color: #C9652F;\n  font-size: 15px;\n  font-weight: 700;\n  text-decoration: underline;\n  text-underline-offset: 4px;\n  display: inline-block;\n  padding-block: 6px;\n  transition: color 160ms ease;\n}\n.nova .editorial-cta__link:hover {\n  color: #A95025;\n}\n\n/* Summary Section (Clean Editorial List) */\n.nova .editorial-summary-section {\n  margin: 32px 0 36px;\n  text-align: right;\n}\n.nova .editorial-summary__title {\n  font-size: 1.3rem;\n  font-weight: 800;\n  color: #171717;\n  margin: 0 0 4px;\n  text-align: right;\n}\n.nova .editorial-summary__subtitle {\n  color: #7A6F66;\n  font-size: 0.95rem;\n  margin: 0 0 14px;\n  text-align: right;\n}\n.nova .article-summary-list {\n  display: grid;\n  gap: 10px;\n  margin: 16px 0 22px;\n  padding: 0;\n  list-style: none;\n}\n.nova .article-summary-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 15px;\n  color: #2F2925;\n  line-height: 1.5;\n}\n.nova .article-summary-item svg {\n  width: 18px;\n  height: 18px;\n  color: #54856C;\n  flex-shrink: 0;\n}\n\n/* CTA 2: Minimal Dark Button */\n.nova .editorial-cta--mid {\n  margin: 20px 0 28px;\n  text-align: right;\n}\n.nova .editorial-cta--mid .editorial-cta__button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 46px;\n  padding: 11px 22px;\n  border: 1px solid #2F2925;\n  border-radius: 6px;\n  background: #2F2925;\n  color: #FFFFFF !important;\n  text-decoration: none !important;\n  font-size: 15px;\n  font-weight: 700;\n  box-shadow: none;\n  transition: background-color 160ms ease, transform 160ms ease;\n}\n.nova .editorial-cta--mid .editorial-cta__button:hover {\n  background: #201C19;\n  transform: translateY(-1px);\n}\n\n/* Final Concluding Section & CTA 3: Strong Dark Filled Button */\n.nova .editorial-final-close {\n  margin: 32px 0 38px;\n  text-align: right;\n}\n.nova .editorial-final-close__title {\n  font-size: 1.3rem;\n  font-weight: 800;\n  color: #171717;\n  line-height: 1.35;\n  margin: 0 0 10px;\n  text-align: right;\n}\n.nova .editorial-final-close__text {\n  font-size: 16px;\n  color: #3D3631;\n  line-height: 1.75;\n  margin: 0 0 20px;\n  text-align: right;\n}\n.nova .editorial-cta--final {\n  margin: 20px 0 0;\n  text-align: right;\n}\n.nova .editorial-cta--final .editorial-cta__button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 52px;\n  padding: 13px 28px;\n  border: 0;\n  border-radius: 7px;\n  background: #2F2925;\n  color: #FFFFFF !important;\n  text-decoration: none !important;\n  font-size: 16px;\n  font-weight: 800;\n  box-shadow: 0 4px 10px rgba(0,0,0,.08);\n  transition: background-color 160ms ease, transform 160ms ease;\n}\n.nova .editorial-cta--final .editorial-cta__button:hover {\n  background: #201C19;\n  transform: translateY(-1px);\n}\n.nova .editorial-cta__microcopy {\n  margin-top: 8px;\n  color: #7A6F67;\n  font-size: 12px;\n  line-height: 1.45;\n  text-align: right;\n}\n\n/* Inline Quote Card */\n.nova .quote {\n  background: #FAF7F2;\n  border-right: 4px solid var(--bronze);\n  border-radius: 0 12px 12px 0;\n  padding: 16px 18px;\n  margin: 20px 0;\n  font-size: 0.95rem;\n}\n.nova .quote p { margin: 0 0 8px; font-style: italic; color: #36312E; }\n.nova .quote-author {\n  font-size: 0.82rem;\n  font-weight: 700;\n  color: #1A1A1A;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n.nova .quote-verified {\n  color: var(--green);\n  font-size: 0.8rem;\n  font-weight: 600;\n}\n\n/* Standalone Editorial Proof Break (Asset 2) */\n.nova .article-proof-break {\n  margin: 38px auto 34px;\n}\n.nova .article-proof-break__title {\n  max-width: 760px;\n  margin: 0 auto 12px;\n  color: #2F2A26;\n  font-size: 18px;\n  font-weight: 700;\n  line-height: 1.4;\n  text-align: right;\n}\n\n/* Testimonials in Reason 6 / Section 15 */\n.nova .testim-grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 16px;\n  margin: 20px 0;\n}\n.nova .testim-card {\n  background: #FFFFFF;\n  border: 1px solid var(--cream-3);\n  border-radius: 14px;\n  padding: 18px 20px;\n  box-shadow: 0 4px 12px rgba(43,36,32,.03);\n}\n.nova .testim-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 12px;\n}\n.nova .testimonial-avatar {\n  width: 48px;\n  height: 48px;\n  border-radius: 50%;\n  object-fit: cover;\n  flex: 0 0 48px;\n  border: 2px solid #E8DFD5;\n}\n.nova .testim-user-info {\n  display: flex;\n  flex-direction: column;\n}\n.nova .testim-name-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n.nova .testim-name {\n  font-size: 14px;\n  font-weight: 700;\n  color: #1A1A1A;\n}\n.nova .testim-verified {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--green);\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n}\n.nova .testim-meta {\n  font-size: 11px;\n  color: #8A776A;\n  margin-top: 2px;\n}\n.nova .testim-text {\n  font-size: 15px;\n  line-height: 1.7;\n  color: #3D3631;\n  margin: 0;\n}\n\n/* Official-Site Trust Box (Dark Brown - High Contrast) */\n.nova .authentic {\n  background: #2F241E !important;\n  border-radius: 16px !important;\n  padding: 24px 26px !important;\n  margin: 28px 0 !important;\n  display: flex !important;\n  align-items: flex-start !important;\n  gap: 16px !important;\n  box-shadow: 0 8px 24px rgba(0,0,0,.12) !important;\n}\n.nova .authentic .ic-svg {\n  width: 32px !important;\n  height: 32px !important;\n  color: #F28A4B !important;\n  flex-shrink: 0 !important;\n  margin-top: 2px !important;\n}\n.nova .official-site-trust-box__title {\n  font-size: 1.1rem !important;\n  font-weight: 800 !important;\n  color: #FFFFFF !important;\n  margin-bottom: 6px !important;\n  display: block !important;\n}\n.nova .official-site-trust-box__text {\n  font-size: 0.94rem !important;\n  color: #F5EEE8 !important;\n  margin: 0 0 10px !important;\n  line-height: 1.7 !important;\n}\n.nova .official-site-trust-box__verified {\n  font-size: 0.86rem !important;\n  font-weight: 700 !important;\n  color: #F07A32 !important;\n  display: inline-block !important;\n}\n\n/* Footer */\n.nova .foot {\n  border-top: 1px solid #E8DFD5;\n  padding: 28px 18px 40px;\n  text-align: center;\n  font-size: 0.85rem;\n  color: #7A6F66;\n  line-height: 1.6;\n}\n\n/* Fade-in Animation */\n.nova .rev {\n  opacity: 0;\n  transform: translateY(16px);\n  transition: opacity .4s ease, transform .4s ease;\n}\n.nova .rev.in {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* Mobile Rules */\n@media (max-width: 749px) {\n  .nova .wrap { padding: 0 16px; }\n  .nova .article-title { font-size: 30px; line-height: 1.22; }\n  .nova .article-hero { width: 100%; margin: 16px auto 20px; }\n  .nova .article-visual { width: 100%; margin: 14px auto 20px; }\n  .nova .article-hero img, .nova .article-visual img { border-radius: 10px; }\n  .nova .article-hero figcaption, .nova .article-visual figcaption { margin-top: 6px; font-size: 12px; line-height: 1.5; }\n  .nova .article-author__avatar { width: 44px; height: 44px; flex-basis: 44px; }\n  .nova .article-author__avatar img { object-position: 48% 30%; }\n  .nova .reason { padding: 20px 16px; }\n  .nova .reason h2 { font-size: 22px; line-height: 1.3; }\n  .nova .article-lead { font-size: 17px; line-height: 1.7; padding-right: 14px; }\n  .nova .official-site-trust-box { padding: 20px 18px !important; }\n  .nova .official-site-trust-box__text { font-size: 14px !important; line-height: 1.75 !important; }\n  \n  /* Mobile CTAs */\n  .nova .editorial-cta--soft { margin: 22px 0 28px; }\n  .nova .editorial-cta__intro { font-size: 14px; }\n  .nova .editorial-cta__link { font-size: 15px; line-height: 1.5; }\n  .nova .editorial-cta--mid .editorial-cta__button { width: 100%; min-height: 50px; font-size: 16px; }\n  .nova .editorial-cta--final .editorial-cta__button { width: 100%; min-height: 54px; padding-inline: 16px; font-size: 16px; }\n  .nova .editorial-cta__microcopy { text-align: center; }\n  .nova .editorial-final-close__title { font-size: 22px; }\n}\n</style>\n\n<div class=\"nova\">\n\n  <!-- 1. Editorial Masthead -->\n  <header class=\"editorial-masthead\">\n    <div class=\"editorial-masthead__brand\">THE BEAUTY DESK</div>\n    <div class=\"editorial-masthead__sub\">מגזין טיפוח ויופי</div>\n  </header>\n\n  <div class=\"wrap\">\n\n    <!-- 2. Breadcrumb & Sponsored Disclosure -->\n    <div class=\"article-meta-nav\">\n      <div class=\"article-breadcrumb\">ראשי › טיפוח ויופי › מדריך לשיער לבן</div>\n      <div class=\"article-disclosure\">תוכן שיווקי בשיתוף NovaHair</div>\n    </div>\n\n    <!-- 3. Main H1 Headline -->\n    <h1 class=\"article-title\">7 סיבות שנשים עם שורשים לבנים עוברות ל-NovaHair במקום לשרוף כסף במספרה</h1>\n\n    <!-- 4. Author & Meta Row (profiles of the news reporter / 5) -->\n    <div class=\"article-author\">\n      <div class=\"article-author__avatar\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/reporter_naama_levy.png?v=1787201561\" alt=\"נעמה לוי\" width=\"1672\" height=\"941\" loading=\"lazy\" decoding=\"async\">\n      </div>\n      <div class=\"article-author__info\">\n        <div class=\"article-author__name\">מאת: נעמה לוי</div>\n        <div class=\"article-author__date\">עודכן לאחרונה: היום · זמן קריאה: כ־3 דקות</div>\n        <div class=\"article-author__rating\">\n          <div class=\"stars-wrap\" style=\"display:inline-flex;gap:2px;align-items:center;\">\n<svg viewbox=\"0 0 20 20\" fill=\"#F59E0B\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:16px;height:16px;display:inline-block;\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\"></path></svg><svg viewbox=\"0 0 20 20\" fill=\"#F59E0B\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:16px;height:16px;display:inline-block;\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\"></path></svg><svg viewbox=\"0 0 20 20\" fill=\"#F59E0B\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:16px;height:16px;display:inline-block;\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\"></path></svg><svg viewbox=\"0 0 20 20\" fill=\"#F59E0B\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:16px;height:16px;display:inline-block;\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\"></path></svg><svg viewbox=\"0 0 20 20\" fill=\"#F59E0B\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:16px;height:16px;display:inline-block;\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\"></path></svg>\n</div>\n          <span>4.8 · 9,232 דירוגים</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 5. Main Hero Image (Batch 8 / Asset 9) -->\n    <figure class=\"article-hero\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/batch8_9.png?v=1787202358\" alt=\"אישה מול המראה בודקת שורשים לבנים\" width=\"1672\" height=\"941\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\">\n      <figcaption>\n        הרגע המוכר מול המראה: השיער עוד נראה מצוין, אבל הפס בשורש כבר מתחיל לחזור.\n      </figcaption>\n    </figure>\n\n    <!-- 6. Opening Lead -->\n    <div class=\"article-lead\">\n      <p>השיער הלבן תמיד חוזר מהר מדי. לפעמים עוד לפני שהספקת ליהנות מהצבע, כבר מציץ פס לבן מעצבן בשביל, ברקות או בקו המצח.</p>\n      <p>NovaHair פותח בדיוק לרגע הזה: כיסוי מהיר ומדויק של השורשים בבית, עם תוצאה טבעית בטיפול של כ־10 דקות בלבד.</p>\n      <p>אז למה יותר ויותר נשים בוחרות בו בין צביעה לצביעה? הנה 7 הסיבות המרכזיות.</p>\n    </div>\n\n    <!-- 7. REASON 1 (Batch 8 / Asset 8) -->\n    <section class=\"reason rev\">\n      <span class=\"badge\">1</span>\n      <h2>נמנע מ\"אפקט הקסדה\": נטמע בשיער במקום להיראות כמו גוש צבע</h2>\n      <p>בצביעת שורשים ביתית, החשש הגדול הוא לא רק אם הלבן ייעלם. הפחד האמיתי הוא שהתוצאה תצא כהה, כבדה וחסרת חיים. NovaHair פותח כדי להשתלב ישירות עם צבע הבסיס של השיער, כך שהגוון נשאר עשיר, בעל עומק ונראה טבעי לחלוטין.</p>\n      <span class=\"sci\">כיסוי שורשים מדויק · השתלבות מושלמת עם גוון הבסיס</span>\n      <figure class=\"article-visual\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/batch8_8.png?v=1787202355\" alt=\"תוצאה טבעית של חידוש שורשים\" width=\"1672\" height=\"941\" loading=\"lazy\" decoding=\"async\">\n        <figcaption>\n          המטרה היא לא רק לכסות את הלבן — אלא שהשורש החדש ישתלב בשיער שכבר יש לך.\n        </figcaption>\n      </figure>\n    </section>\n\n    <!-- 8. REASON 2 (Batch 8 / Asset 7) -->\n    <section class=\"reason rev\">\n      <span class=\"badge\">2</span>\n      <h2>10 דקות במקלחת במקום לתכנן יום שלם סביב תור למספרה</h2>\n      <p>בלי לחפש תור שבועות מראש, להיתקע בפקקים, לחפש חניה ולשבת שעות בהמתנה. פשוט מורחים על האזורים שצריכים כיסוי, ממתינים 10 דקות בלבד ושוטפים. זה הופך את תחזוקת השורשים ממבצע מעייף לפעולה פשוטה שלוקחת כמה דקות בשגרה.</p>\n      <figure class=\"article-visual\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/batch8_7.png?v=1787202352\" alt=\"חידוש שורשים בבית כחלק משגרת הבוקר\" width=\"1672\" height=\"941\" loading=\"lazy\" decoding=\"async\">\n        <figcaption>\n          חידוש השורשים נכנס לשגרת הבוקר, במקום להפוך לעוד משימה של חצי יום.\n        </figcaption>\n      </figure>\n\n      <!-- Inline Testimonial -->\n      <div class=\"quote\">\n        <p>\"פעם ראשונה שצבעתי בבית בלי שהעיניים שורפות ובלי ריח מחניק. הגוון יצא כל כך טבעי שהספרית שלי הייתה בטוחה שעשיתי טיפול מקצועי.\"</p>\n        <div class=\"quote-author\">\n          <span>שירה כ., בת 38, ראשון לציון</span>\n          <span class=\"quote-verified\">✓ קונה מאומתת</span>\n        </div>\n      </div>\n    </section>\n\n    <!-- 9. CTA 1 (SOFT EDITORIAL TEXT LINK) -->\n    <div class=\"editorial-cta editorial-cta--soft rev\">\n      <p class=\"editorial-cta__intro\">רוצה לראות איזה גוון מתאים לך?</p>\n      <a class=\"editorial-cta__link\" data-placement=\"mid1\" href=\"https://tigerbrandsglobal.com/pages/novahair-sales-staging\">\n        לצפייה בגוונים ובמארזים בעמוד הרשמי ›\n      </a>\n    </div>\n\n    <!-- 10. REASON 3 (Batch 8 / Asset 6) -->\n    <section class=\"reason rev\">\n      <span class=\"badge\">3</span>\n      <h2>Micro-Color Sphere™: פיגמנט שעוטף את השערה, לא אוטם אותה</h2>\n      <p>כאן טמון הסוד לתוצאה הטבעית. טכנולוגיית Micro-Color Sphere™ מפזרת מיקרו-חלקיקי צבע לאורך מעטפת השערה, כך שהכיסוי נבנה בשכבה דקה שמתמזגת עם צבע השיער הקיים במקום לאטום אותו בצבע גס. התוצאה היא ברק, רכות ומראה שלא מסגיר צביעה ביתית.</p>\n      <span class=\"sci\">ננו-פיגמנטציה מדויקת · שמירה מלאה על סיב השערה</span>\n      <figure class=\"article-visual\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/batch8_6.png?v=1787202350\" alt=\"הדמיית Micro-Color Sphere על סיב השערה\" width=\"1672\" height=\"941\" loading=\"lazy\" decoding=\"async\">\n        <figcaption>\n          הרעיון: לבנות כיסוי לאורך השערה, במקום מראה כהה ושטוח שיושב מעליה.\n        </figcaption>\n      </figure>\n    </section>\n\n    <!-- 11. REASON 4 (Batch 8 / Asset 5) -->\n    <section class=\"reason rev\">\n      <span class=\"badge\">4</span>\n      <h2>הרבה מעבר לצבע: פורמולה צמחית שמזינה ומרככת את השיער</h2>\n      <p>NovaHair לא רק מעניק צבע עמוק. הפורמולה נטולת האמוניה מועשרת בתמציות Fo-Ti, ג'ינסנג קוריאני ושומשום שחור, כדי להעניק בוסט של לחות, ברק ומגע משי כבר בזמן הטיפול. כך שהתחזוקה השוטפת לא מייבשת את השיער ולא פוגעת בקרקפת.</p>\n      <span class=\"sci\">רמת חומציות מאוזנת pH 5.5 · ללא תחושת גירוי</span>\n      <figure class=\"article-visual\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/batch8_5.png?v=1787202347\" alt=\"רכיבים בוטניים בפורמולת NovaHair\" width=\"1672\" height=\"941\" loading=\"lazy\" decoding=\"async\">\n        <figcaption>\n          שמנים ותמציות בוטניות משלימים את פעולת הצביעה בתחושת טיפוח, רכות וברק.\n        </figcaption>\n      </figure>\n      <p style=\"margin-top:14px;margin-bottom:0;\">וזה בדיוק מה שהופך את NovaHair לפתרון אידיאלי שמשתלב בקלות בשגרה, בלי בלגן ובלי נזקים.</p>\n    </section>\n\n    <!-- 12. CLEAN EDITORIAL SUMMARY & CTA 2 (MINIMAL DARK BUTTON) -->\n    <div class=\"editorial-summary-section rev\">\n      <h3 class=\"editorial-summary__title\">בשורה התחתונה</h3>\n      <p class=\"editorial-summary__subtitle\">NovaHair בקצרה:</p>\n      <ul class=\"article-summary-list\">\n        <li class=\"article-summary-item\">\n          <svg viewbox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\" clip-rule=\"evenodd\"></path></svg>\n          <span><strong>כ־10 דקות בלבד:</strong> טיפול קל ומהיר בבית</span>\n        </li>\n        <li class=\"article-summary-item\">\n          <svg viewbox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\" clip-rule=\"evenodd\"></path></svg>\n          <span><strong>5 גוונים:</strong> להתאמה מדויקת לצבע שלך</span>\n        </li>\n        <li class=\"article-summary-item\">\n          <svg viewbox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\" clip-rule=\"evenodd\"></path></svg>\n          <span><strong>עד 30 טיפולים:</strong> בבקבוק אחד מרוכז</span>\n        </li>\n        <li class=\"article-summary-item\">\n          <svg viewbox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\" clip-rule=\"evenodd\"></path></svg>\n          <span><strong>60 יום:</strong> אחריות מלאה ללא סיכון</span>\n        </li>\n      </ul>\n      <div class=\"editorial-cta editorial-cta--mid\">\n        <a class=\"editorial-cta__button\" data-placement=\"mid2\" href=\"https://tigerbrandsglobal.com/pages/novahair-sales-staging\">\n          לבדיקת הגוון והחבילות בעמוד הרשמי ›\n        </a>\n      </div>\n    </div>\n\n    <!-- 13. REASON 5 (Batch 8 / Asset 4) -->\n    <section class=\"reason rev\">\n      <span class=\"badge\">5</span>\n      <h2>5 גוונים מותאמים, כדי שהכיסוי ייראה בדיוק כמו הצבע המקורי שלך</h2>\n      <p>שורשים לבנים דורשים דיוק ולא גוון \"ליד\". NovaHair מגיע ב־5 גוונים שפותחו במיוחד להשתלבות חלקה עם צבע הבסיס: שחור, חום כהה, חום בהיר, אדום וסגול. בוחרים את הגוון הקרוב ביותר לשיער שלך, ומחדשים בדיוק את האזורים שצריכים רענון.</p>\n      <span class=\"sci\">שחור · חום כהה · חום בהיר · אדום · סגול</span>\n      <figure class=\"article-visual\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/batch8_4.png?v=1787202344\" alt=\"מבחר גווני שיער של NovaHair\" width=\"1672\" height=\"941\" loading=\"lazy\" decoding=\"async\">\n        <figcaption>\n          לא כל חום נראה אותו דבר — התאמת הגוון לצבע הבסיס היא חלק מההבדל בתוצאה.\n        </figcaption>\n      </figure>\n    </section>\n\n    <!-- 14. BEARD BONUS -->\n    <section class=\"reason rev\" style=\"border-right: 4px solid var(--ink);\">\n      <span class=\"badge badge-bonus\">בונוס קטן:</span>\n      <h2>מתאים בצורה מושלמת גם לזקן ולשפם</h2>\n      <p>יש בבית מישהו עם שיער לבן בזקן או בשפם? אותו NovaHair עובד מצוין גם שם. אין צורך לרכוש מוצר צבע נוסף ונפרד רק בשביל כמה נגיעות לבנות.</p>\n      <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/a16176e3-356b-4b90-bd7b-907f3fd036ce.webp?v=1786916381\" alt=\"כיסוי שערות שיבה בזקן ובשפם\" class=\"reason-img\" loading=\"lazy\">\n      <span class=\"sci\">כיסוי מדויק לזקן ולשפם · ללא מריחות וללא כתמים על העור</span>\n    </section>\n\n    <!-- 15. REASON 6 (Batch 8 / Asset 3) -->\n    <section class=\"reason rev\">\n      <span class=\"badge\">6</span>\n      <h2>הלבן יחזור, אבל אין שום סיבה לשלם מאות שקלים בכל פעם מחדש</h2>\n      <p>עוד תור, עוד נסיעה ועוד חשבון שנפתח ב-₪150 ומעלה במספרה. ההוצאה הזו מצטברת לאלפי שקלים בשנה. בקבוק NovaHair מספק עד 30 טיפולי שורשים מלאים, כך שאפשר לרענן את הצבע בדיוק כשצריך, בזמן שלך, ובשבריר מהמחיר של ביקור במספרה.</p>\n      <span class=\"sci\">עד 30 טיפולי שורשים לבקבוק · חבילות החל מ־₪189 · משלוח חינם</span>\n      <figure class=\"article-visual\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/batch8_3.png?v=1787202341\" alt=\"NovaHair לשימוש ביתי וחיסכון בביקורים במספרה\" width=\"1672\" height=\"941\" loading=\"lazy\" decoding=\"async\">\n        <figcaption>\n          כשחידוש השורשים עובר הביתה, לא כל הופעה של הלבן דורשת תור חדש.\n        </figcaption>\n      </figure>\n    </section>\n\n    <!-- 16. TESTIMONIALS (3 UPGRADED PROFILE CARDS) -->\n    <section class=\"reason rev\" style=\"background:#FAF7F2;\">\n      <span class=\"sci\" style=\"border:0;padding:0;margin:0 0 6px;color:var(--bronze);font-size:0.85rem;\">מה אומרים אחרי שמנסים בבית?</span>\n      <h2>בסופו של דבר, התוצאה צריכה לעבור את מבחן המראה</h2>\n      <p style=\"color:var(--ink-soft);font-size:0.95rem;\">לא הבטחות גדולות. פשוט החוויה של לקוחות שכבר הכניסו את NovaHair לשגרה שלהן.</p>\n\n      <div class=\"testim-grid\">\n        <!-- Testimonial 1: Ronit (Image 2) -->\n        <article class=\"testim-card\">\n          <div class=\"testim-header\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/testimonial_avatar_ronit.png?v=1787199413\" alt=\"רונית ל.\" class=\"testimonial-avatar\" width=\"48\" height=\"48\" loading=\"lazy\">\n            <div class=\"testim-user-info\">\n              <div class=\"testim-name-row\">\n                <span class=\"testim-name\">רונית ל.</span>\n                <span class=\"testim-verified\">✓ קונה מאומתת</span>\n              </div>\n              <span class=\"testim-meta\">לפני יומיים · 84 לייקים</span>\n            </div>\n          </div>\n          <p class=\"testim-text\">\"חיכיתי לראות תוך כמה זמן השורשים יציצו שוב. עברו כמעט חודש והשיער עדיין נראה מעולה ומכוסה לגמרי. פשוט תענוג!\"</p>\n        </article>\n\n        <!-- Testimonial 2: Dana (Image 3) -->\n        <article class=\"testim-card\">\n          <div class=\"testim-header\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/testimonial_avatar_dana.png?v=1787199416\" alt=\"דנה פ.\" class=\"testimonial-avatar\" width=\"48\" height=\"48\" loading=\"lazy\">\n            <div class=\"testim-user-info\">\n              <div class=\"testim-name-row\">\n                <span class=\"testim-name\">דנה פ.</span>\n                <span class=\"testim-verified\">✓ קונה מאומתת</span>\n              </div>\n              <span class=\"testim-meta\">לפני 5 ימים · 121 לייקים</span>\n            </div>\n          </div>\n          <p class=\"testim-text\">\"הזמנתי לאמא וניסיתי בעצמי על השביל. השיער יצא סופר רך ומבריק, בלי היובש והקשיחות של צבע רגיל.\"</p>\n        </article>\n\n        <!-- Testimonial 3: Avi (Image 1 - Masculine קונה מאומת) -->\n        <article class=\"testim-card\">\n          <div class=\"testim-header\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/testimonial_avatar_avi.png?v=1787199411\" alt=\"אבי ט.\" class=\"testimonial-avatar\" width=\"48\" height=\"48\" loading=\"lazy\">\n            <div class=\"testim-user-info\">\n              <div class=\"testim-name-row\">\n                <span class=\"testim-name\">אבי ט.</span>\n                <span class=\"testim-verified\">✓ קונה מאומת</span>\n              </div>\n              <span class=\"testim-meta\">לפני שבוע · 67 לייקים</span>\n            </div>\n          </div>\n          <p class=\"testim-text\">\"אשתי הזמינה לעצמה ולקחתי קצת לזקן. כיסה את כל הלבן תוך כמה דקות ובלי להשאיר כתמי צבע על הפנים.\"</p>\n        </article>\n      </div>\n    </section>\n\n    <!-- 17. STANDALONE EDITORIAL PROOF / AFTER BREAK (Batch 8 / Asset 2) -->\n    <section class=\"article-proof-break rev\">\n      <h3 class=\"article-proof-break__title\">איך זה נראה אחרי?</h3>\n      <figure class=\"article-visual\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/batch8_2.png?v=1787202339\" alt=\"תוצאה לאחר חידוש שורשים מול המראה\" width=\"1672\" height=\"941\" loading=\"lazy\" decoding=\"async\">\n        <figcaption>\n          החלק שמרגישים במראה: השורש חוזר להיראות חלק מהשיער, ולא הדבר הראשון שרואים.\n        </figcaption>\n      </figure>\n    </section>\n\n    <!-- 18. REASON 7 (Batch 8 / Asset 1) -->\n    <section class=\"reason rev\">\n      <span class=\"badge\">7</span>\n      <h2>60 ימי התנסות ללא סיכון: תראי את התוצאה מול המראה שלך</h2>\n      <p>צבע לשיער לא בוחרים רק לפי תמונות במסך – צריך לראות אותו בפועל על השיער שלך. לכן כל הזמנה מגיעה עם 60 ימי אחריות מלאה. נסי את NovaHair בבית, בדקי את התאמת הגוון ואיך הוא משתלב בשגרה שלך. אם לא אהבת את התוצאה, פשוט פונים לשירות הלקוחות ומקבלים החזר.</p>\n      <span class=\"sci\">60 ימי אחריות · משלוח חינם לכל הארץ · שירות לקוחות ישראלי</span>\n      <figure class=\"article-visual\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0719/2628/4583/files/batch8_1.png?v=1787202336\" alt=\"חבילת NovaHair בבית כחלק מהתנסות של 60 יום\" width=\"1672\" height=\"941\" loading=\"lazy\" decoding=\"async\">\n        <figcaption>\n          60 יום לבדוק איך NovaHair משתלב בשגרה שלך.\n        </figcaption>\n      </figure>\n    </section>\n\n    <!-- 19. OFFICIAL-SITE TRUST BLOCK (FIXED HIGH CONTRAST) -->\n    <div class=\"authentic official-site-trust-box rev\">\n      <svg class=\"ic-svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n      </svg>\n      <div>\n        <span class=\"official-site-trust-box__title\">ביטחון מלא בכל הזמנה</span>\n        <p class=\"official-site-trust-box__text\">ברכישה דרך האתר הרשמי של NovaHair בישראל, את מקבלת את המוצר המקורי עם האחריות והשירות המלאים שלנו. כך יש לך כתובת ישירה ומענה אנושי לכל שאלה.</p>\n        <span class=\"official-site-trust-box__verified\">✓ האתר הרשמי בישראל</span>\n      </div>\n    </div>\n\n    <!-- 20. FINAL NARRATIVE CLOSE & CTA 3 (STRONG DARK FILLED BUTTON) -->\n    <div class=\"editorial-final-close rev\">\n      <h3 class=\"editorial-final-close__title\">השיער הלבן ימשיך לגדול – אבל הטיפול בו ממש לא חייב להיות כאב ראש יקר.</h3>\n      <p class=\"editorial-final-close__text\">אם את מחפשת דרך קלה, מהירה וחסכונית לשמור על שורשים מטופחים, לחצי כאן כדי לראות את 5 הגוונים והמארזים שבמבצע.</p>\n      <div class=\"editorial-cta editorial-cta--final\">\n        <a class=\"editorial-cta__button\" data-placement=\"final\" href=\"https://tigerbrandsglobal.com/pages/novahair-sales-staging\">\n          לצפייה בגוונים ובמארזים של NovaHair ›\n        </a>\n        <div class=\"editorial-cta__microcopy\">5 גוונים · 3 חבילות · משלוח חינם · 60 יום אחריות</div>\n      </div>\n    </div>\n\n    <!-- 21. FOOTER -->\n    <div class=\"foot\">\n      Nova Hair · משלוח חינם לכל הארץ · 60 יום אחריות מלאה<br>\n      *תוכן שיווקי. התוצאות עשויות להשתנות מאדם לאדם ואינן מהוות תחליף לייעוץ מקצועי.*\n    </div>\n\n  </div>\n\n</div>\n\n<!-- Fade-in Scroll Observer -->\n<script>\n(function(){\n  var r = document.querySelector('.nova');\n  if (!r) return;\n  var io = new IntersectionObserver(function(es){\n    es.forEach(function(e){\n      if(e.isIntersecting){\n        e.target.classList.add('in');\n        io.unobserve(e.target);\n      }\n    });\n  }, {threshold: .1});\n  r.querySelectorAll('.rev').forEach(function(el){ io.observe(el); });\n})();\n</script>\n\n<!-- UTM Parameter Forwarding -->\n<script id=\"utm-forwarder\">\n(function(){\n  try {\n    var search = window.location.search;\n    if (!search || search.length < 2) return;\n    var params = new URLSearchParams(search);\n    var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'gclid', 'ttclid'];\n    var forwardParams = new URLSearchParams();\n    keys.forEach(function(k){\n      var v = params.get(k);\n      if (v) forwardParams.set(k, v);\n    });\n    var qStr = forwardParams.toString();\n    if (!qStr) return;\n\n    document.addEventListener('DOMContentLoaded', function(){\n      var links = document.querySelectorAll('a[href*=\"novahair-sales-staging\"]');\n      links.forEach(function(a){\n        var u = new URL(a.href, window.location.origin);\n        forwardParams.forEach(function(val, key){\n          u.searchParams.set(key, val);\n        });\n        a.href = u.toString();\n      });\n    });\n  } catch(e){}\n})();\n</script>\n\n<!-- CRO Analytics Tracking -->\n<script id=\"nh-cro-7reasons\">\n(function(){\n  function emitCroEvent(eventName, payload) {\n    var publishedToShopify = false;\n    try {\n      if (window.Shopify && window.Shopify.analytics && typeof window.Shopify.analytics.publish === 'function') {\n        window.Shopify.analytics.publish(eventName, payload);\n        publishedToShopify = true;\n      }\n    } catch(err) {\n      console.warn('[NovaHair Shopify Publish Error]', err);\n    }\n\n    try {\n      window._nh_events = window._nh_events || [];\n      window._nh_events.push({\n        event: eventName,\n        payload: payload,\n        published_to_shopify: publishedToShopify,\n        ts: Date.now()\n      });\n\n      window.dispatchEvent(new CustomEvent(eventName, { detail: payload }));\n      if (window.dataLayer && Array.isArray(window.dataLayer)) {\n        window.dataLayer.push(Object.assign({ event: eventName }, payload));\n      }\n      console.log('[NovaHair CRO Event]', eventName, 'ShopifyPublished:', publishedToShopify, payload);\n    } catch(e){}\n  }\n\n  var fired = { s25: false, s50: false, s75: false, s100: false };\n  var ticking = false;\n\n  function checkScroll() {\n    var winHeight = window.innerHeight || document.documentElement.clientHeight;\n    var docHeight = Math.max(\n      document.body.scrollHeight, document.documentElement.scrollHeight,\n      document.body.offsetHeight, document.offsetHeight || 0,\n      document.body.clientHeight, document.documentElement.clientHeight\n    );\n    var scrollTop = window.pageYOffset || (document.documentElement || document.body.parentNode || document.body).scrollTop;\n    var scrollable = docHeight - winHeight;\n    if (scrollable <= 0) return;\n\n    var pct = Math.min(100, Math.round(((scrollTop + winHeight) / docHeight) * 100));\n\n    if (pct >= 25 && !fired.s25) {\n      fired.s25 = true;\n      emitCroEvent('novahair_7reasons_scroll_25', { scroll_depth: 25, current_url: window.location.href });\n    }\n    if (pct >= 50 && !fired.s50) {\n      fired.s50 = true;\n      emitCroEvent('novahair_7reasons_scroll_50', { scroll_depth: 50, current_url: window.location.href });\n    }\n    if (pct >= 75 && !fired.s75) {\n      fired.s75 = true;\n      emitCroEvent('novahair_7reasons_scroll_75', { scroll_depth: 75, current_url: window.location.href });\n    }\n    if (pct >= 95 && !fired.s100) {\n      fired.s100 = true;\n      emitCroEvent('novahair_7reasons_scroll_100', { scroll_depth: 100, current_url: window.location.href });\n    }\n    ticking = false;\n  }\n\n  window.addEventListener('scroll', function(){\n    if (!ticking) {\n      window.requestAnimationFrame(checkScroll);\n      ticking = true;\n    }\n  }, { passive: true });\n\n  document.addEventListener('DOMContentLoaded', function(){\n    var ctaLinks = document.querySelectorAll('a[href*=\"novahair-sales-staging\"]');\n    ctaLinks.forEach(function(a){\n      a.addEventListener('click', function(e){\n        var placement = a.getAttribute('data-placement') || 'general';\n        var urlParams = new URLSearchParams(window.location.search);\n        var payload = {\n          placement: placement,\n          destination: a.href,\n          current_url: window.location.href,\n          utm_campaign: urlParams.get('utm_campaign') || '',\n          utm_content: urlParams.get('utm_content') || ''\n        };\n        emitCroEvent('novahair_7reasons_cta_click', payload);\n      });\n    });\n  });\n})();\n</script>\n",
