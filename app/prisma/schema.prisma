generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Shop {
  id        String   @id @default(uuid())
  domain    String   @unique
  createdAt DateTime @default(now())
  funnels   Funnel[]
  visitors  Visitor[]
  events    Event[]
  checkouts CheckoutAttribution[]
  orders    OrderAttribution[]
  webhookDeliveries ShopifyWebhookDelivery[]
}

model Funnel {
  id         String   @id @default(uuid())
  shopId     String
  name       String
  slug       String
  status     String   @default("DRAFT")
  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  shop       Shop     @relation(fields: [shopId], references: [id])
  steps      Step[]
  events     Event[]

  @@unique([shopId, slug])
  @@index([shopId, status])
}

model Step {
  id         String    @id @default(uuid())
  funnelId   String
  position   Int
  name       String
  kind       String    @default("LANDING")
  createdAt  DateTime  @default(now())
  funnel     Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  variants   Variant[]
  experiment Experiment?
  events     Event[]

  @@unique([funnelId, position])
  @@index([funnelId])
}

model Variant {
  id                 String              @id @default(uuid())
  stepId             String
  name               String
  publishedVersionId String?             @unique
  createdAt          DateTime            @default(now())
  step               Step                @relation(fields: [stepId], references: [id], onDelete: Cascade)
  versions           ContentVersion[]
  allocations        ExperimentAllocation[]
  assignments        Assignment[]
  events             Event[]

  @@unique([stepId, name])
  @@index([stepId])
}

model ContentVersion {
  id             String   @id @default(uuid())
  variantId      String
  revision       Int
  state          String   @default("DRAFT")
  rawHtml        String
  normalizedHtml String
  portReport     String   @default("{}")
  createdAt      DateTime @default(now())
  publishedAt    DateTime?
  variant        Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, revision])
  @@index([variantId, state])
}

model Experiment {
  id                String               @id @default(uuid())
  stepId            String               @unique
  status            String               @default("DRAFT")
  allocationVersion Int                  @default(1)
  createdAt         DateTime             @default(now())
  step              Step                 @relation(fields: [stepId], references: [id], onDelete: Cascade)
  allocations       ExperimentAllocation[]
  assignments       Assignment[]
}

model ExperimentAllocation {
  id                String     @id @default(uuid())
  experimentId      String
  variantId         String
  weightBasisPoints Int
  experiment        Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant           Variant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, variantId])
  @@index([experimentId])
}

model Visitor {
  id               String       @id @default(uuid())
  shopId           String
  anonymousKeyHash String
  createdAt        DateTime     @default(now())
  shop             Shop         @relation(fields: [shopId], references: [id])
  assignments      Assignment[]
  events           Event[]
  checkouts        CheckoutAttribution[]

  @@unique([shopId, anonymousKeyHash])
}

model Assignment {
  id           String     @id @default(uuid())
  visitorId    String
  experimentId String
  variantId    String
  assignedAt   DateTime   @default(now())
  visitor      Visitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant      Variant    @relation(fields: [variantId], references: [id])

  @@unique([visitorId, experimentId])
  @@index([experimentId, variantId])
}

model Event {
  id            String   @id @default(uuid())
  shopId        String
  eventKey      String   @unique
  name          String
  source        String   @default("SYNTHETIC")
  occurredAt    DateTime
  receivedAt    DateTime @default(now())
  visitorId     String?
  funnelId      String?
  stepId        String?
  variantId     String?
  checkoutToken String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  deviceClass   String?
  payload       String   @default("{}")
  isTest        Boolean  @default(true)
  shop          Shop     @relation(fields: [shopId], references: [id])
  visitor       Visitor? @relation(fields: [visitorId], references: [id])
  funnel        Funnel?  @relation(fields: [funnelId], references: [id])
  step          Step?    @relation(fields: [stepId], references: [id])
  variant       Variant? @relation(fields: [variantId], references: [id])

  @@index([funnelId, stepId, variantId, occurredAt])
  @@index([checkoutToken])
}

model CheckoutAttribution {
  id            String   @id @default(uuid())
  shopId        String
  checkoutToken String   @unique
  visitorId     String?
  funnelId      String?
  lastStepId    String?
  lastVariantId String?
  startedAt     DateTime
  completedAt   DateTime?
  confidence    String   @default("MEDIUM")
  shop          Shop     @relation(fields: [shopId], references: [id])
  visitor       Visitor? @relation(fields: [visitorId], references: [id])
  orders        OrderAttribution[]

  @@index([funnelId])
}

model OrderAttribution {
  id               String              @id @default(uuid())
  shopId           String
  shopifyOrderGid  String              @unique
  checkoutToken    String?
  funnelId         String?
  variantId        String?
  currency         String
  grossAmount      Float
  netRevenueAmount Float
  refundedAmount   Float      @default(0)
  status           String     @default("PAID")
  confidence       String
  isTest           Boolean             @default(true)
  paidAt           DateTime
  cancelledAt      DateTime?
  updatedAt        DateTime             @default(now()) @updatedAt
  shop             Shop                @relation(fields: [shopId], references: [id])
  checkout         CheckoutAttribution? @relation(fields: [checkoutToken], references: [checkoutToken])

  @@index([funnelId, variantId, paidAt])
}

model ShopifyWebhookDelivery {
  id         String   @id @default(uuid())
  shopId     String
  webhookId  String   @unique
  topic      String
  receivedAt DateTime @default(now())
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, topic, receivedAt])
}

model BotConfiguration {
  id           String   @id @default(uuid())
  shopDomain   String   @unique
  status       String   @default("DRAFT")
  name         String
  label        String
  welcome      String
  placement    String
  routingJson  String   @default("{}")
  playbookJson String   @default("{}")
  offersJson   String   @default("{}")
  crmJson      String   @default("{}")
  securityJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  modelVariants BotModelVariant[]

  @@index([status, updatedAt])
}

model BotModelVariant {
  id                 String           @id @default(uuid())
  botConfigurationId String
  slot               Int
  provider           String
  model              String
  trafficBasisPoints Int
  enabled            Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  botConfiguration   BotConfiguration @relation(fields: [botConfigurationId], references: [id], onDelete: Cascade)

  @@unique([botConfigurationId, slot])
  @@index([botConfigurationId, enabled])
}

model PopupCampaign {
  id                String         @id @default(uuid())
  shopDomain        String
  key               String
  name              String
  type              String
  status            String         @default("DRAFT")
  experimentVersion Int            @default(1)
  triggerJson       String         @default("{}")
  targetingJson     String         @default("{}")
  frequencyJson     String         @default("{}")
  safetyJson        String         @default("{}")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  variants          PopupVariant[]
  events            PopupEvent[]

  @@unique([shopDomain, key])
  @@index([shopDomain, status, updatedAt])
}

model PopupVariant {
  id                String        @id @default(uuid())
  popupCampaignId   String
  key               String
  name              String
  weightBasisPoints Int
  creativeJson      String        @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  popupCampaign     PopupCampaign @relation(fields: [popupCampaignId], references: [id], onDelete: Cascade)

  @@unique([popupCampaignId, key])
  @@index([popupCampaignId])
}

model PopupEvent {
  id             String        @id @default(uuid())
  eventKey       String        @unique
  shopDomain     String
  popupCampaignId String
  campaignKey    String
  variantKey     String?
  visitorHash    String?
  sessionHash    String?
  name           String
  occurredAt     DateTime
  receivedAt     DateTime      @default(now())
  metadataJson   String        @default("{}")
  isTest         Boolean       @default(true)
  popupCampaign  PopupCampaign @relation(fields: [popupCampaignId], references: [id], onDelete: Cascade)

  @@index([shopDomain, campaignKey, name, occurredAt])
  @@index([popupCampaignId, variantKey, occurredAt])
}

model PopupExperimentAssignment {
  id                String                    @id @default(uuid())
  shopDomain        String
  campaignKey       String
  experimentVersion Int
  visitorHash       String
  sessionHash       String
  group             String
  variantKey        String?
  holdoutBucket     Int
  variantBucket     Int?
  assignedAt        DateTime                  @default(now())
  lastSeenAt        DateTime                  @default(now())
  isTest            Boolean                   @default(true)
  conversions       PopupCheckoutConversion[]

  @@unique([shopDomain, campaignKey, experimentVersion, visitorHash])
  @@index([shopDomain, campaignKey, experimentVersion, group, assignedAt])
  @@index([sessionHash, assignedAt])
}

model PopupCheckoutConversion {
  id                  String                    @id @default(uuid())
  popupAssignmentId   String
  checkoutToken       String
  checkoutStartedAt   DateTime
  checkoutCompletedAt DateTime?
  shopifyOrderGid     String?
  currency            String?
  grossAmount         Float?
  netRevenueAmount    Float?
  refundedAmount      Float?
  orderStatus         String?
  orderPaidAt         DateTime?
  verifiedAt          DateTime?
  source              String                    @default("SHOPIFY_PIXEL")
  isTest              Boolean                   @default(true)
  popupAssignment     PopupExperimentAssignment @relation(fields: [popupAssignmentId], references: [id], onDelete: Cascade)

  @@unique([popupAssignmentId, checkoutToken])
  @@index([checkoutToken])
  @@index([shopifyOrderGid])
}
