{%- comment -%}
  The promotion page. One rotating offer a day, plus the week's running offer.

  The page rotates itself. The schedule lives in a shop metafield and this
  section picks today's row out of it on every request, so nothing has to edit
  the page at midnight and nothing breaks if a scheduled job misses a run.

  Two days in the schedule are marked dark. On Yom Kippur the country stops,
  and a store running a sale through it reads as tone deaf, so the page shows a
  quiet holding state instead of an offer.

  The real price change is done by Shopify automatic discounts with their own
  start and end timestamps. This section only tells the customer what is on.
{%- endcomment -%}

{{ 'nova-deals.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cal = shop.metafields.nova.promo_calendar.value
  assign today = 'now' | date: '%Y-%m-%d'
  assign now_hour = 'now' | date: '%H' | times: 1

  assign day_count = 0
  if cal.days
    assign day_count = cal.days.size
  endif

  assign today_index = -1
  for d in cal.days
    if d.date == today
      assign today_index = forloop.index0
      break
    endif
  endfor
-%}

<section class="nova-deals" dir="rtl">
  <header class="nd-head">
    <p class="nd-eyebrow">{{ cal.eyebrow | default: 'מבצעי ספטמבר' | escape }}</p>
    <h1 class="nd-title">{{ cal.title | default: 'שבועיים של טיפוח' | escape }}</h1>
    {%- if cal.intro != blank -%}
      <p class="nd-intro">{{ cal.intro | escape }}</p>
    {%- endif -%}
  </header>

  {%- if today_index == -1 -%}
    {%- comment -%} Outside the run. Say so plainly instead of showing a stale offer. {%- endcomment -%}
    <div class="nd-card nd-card--quiet">
      <h2 class="nd-quiet-title">{{ cal.closed_title | default: 'המבצעים חזרו למדף' | escape }}</h2>
      <p class="nd-quiet-body">{{ cal.closed_body | default: 'הסבב הנוכחי הסתיים. הקטלוג המלא פתוח כרגיל.' | escape }}</p>
      <a class="nd-btn" href="/collections/all">לקטלוג המלא</a>
    </div>

  {%- else -%}
    {%- assign day = cal.days[today_index] -%}

    {%- if day.dark -%}
      <div class="nd-card nd-card--quiet">
        <h2 class="nd-quiet-title">{{ day.dark_title | escape }}</h2>
        <p class="nd-quiet-body">{{ day.dark_body | escape }}</p>
        {%- assign next_live = -1 -%}
        {%- for d in cal.days offset: today_index -%}
          {%- unless d.dark -%}
            {%- assign next_live = forloop.index0 | plus: today_index -%}
            {%- break -%}
          {%- endunless -%}
        {%- endfor -%}
        {%- if next_live > -1 -%}
          <p class="nd-quiet-next">המבצעים ממשיכים ב{{ cal.days[next_live].date | date: '%d.%m' }}.</p>
        {%- endif -%}
      </div>

    {%- else -%}
      {%- comment -%}
        A day can be one hero, three products around a theme, or a routine
        bought together. One SKU a day for two weeks is monotonous and it never
        moves the basket, so the calendar carries a kind and this renders each
        one differently.
      {%- endcomment -%}
      {%- assign handles = day.handles | default: nil -%}
      {%- if handles == nil or handles == blank -%}
        {%- assign handles = day.handle | split: ',' -%}
      {%- endif -%}

      {%- assign shown_any = false -%}
      {%- assign bundle_now = 0 -%}
      {%- assign bundle_was = 0 -%}

      <article class="nd-card nd-day nd-day--{{ day.kind | default: 'product' }}">
        <div class="nd-flag">
          <span class="nd-flag-label">{{ day.label | default: 'המבצע של היום' | escape }}</span>
          <span class="nd-flag-date">{{ day.date | date: '%d.%m' }}</span>
        </div>

        <div class="nd-day__head">
          <h2 class="nd-day__title">{{ day.headline | default: '' | escape }}</h2>
          {%- if day.line != blank -%}
            <p class="nd-day__line">{{ day.line | escape }}</p>
          {%- endif -%}
        </div>

        <ul class="nd-items nd-items--{{ handles.size }}">
          {%- for h in handles -%}
            {%- assign dh = h | strip -%}
            {%- assign dp = all_products[dh] -%}
            {%- if dp == blank or dp.available == false -%}{%- continue -%}{%- endif -%}
            {%- assign dv = dp.selected_or_first_available_variant -%}
            {%- assign was = dv.price -%}
            {%- assign now_price = was | times: day.keep_percent | divided_by: 100 -%}
            {%- assign bundle_was = bundle_was | plus: was -%}
            {%- assign bundle_now = bundle_now | plus: now_price -%}
            {%- assign shown_any = true -%}

            <li class="nd-item">
              <a class="nd-item__media" href="{{ dp.url }}" tabindex="-1" aria-hidden="true">
                {%- if dp.featured_media -%}
                  {{ dp.featured_media | image_url: width: 600 | image_tag:
                       widths: '200,400,600', sizes: '(min-width: 750px) 240px, 40vw',
                       loading: 'eager',
                       alt: dp.featured_media.alt | default: dp.title | escape }}
                {%- endif -%}
              </a>
              <div class="nd-item__body">
                {%- assign np = dp.title | split: ' - ' -%}
                {%- if np.size > 1 -%}
                  <p class="nd-item__brand">{{ np[0] | strip | escape }}</p>
                  <a class="nd-item__name" href="{{ dp.url }}">{{ np | slice: 1, 9 | join: ' ' | strip | escape }}</a>
                {%- else -%}
                  <a class="nd-item__name" href="{{ dp.url }}">{{ dp.title | escape }}</a>
                {%- endif -%}
                <p class="nd-item__prices">
                  <span class="nd-item__now">{% render 'nova-money', cents: now_price, symbol: '₪' %}</span>
                  <s class="nd-item__was">{% render 'nova-money', cents: was, symbol: '₪' %}</s>
                </p>
                <a class="nd-item__cta" href="{{ dp.url }}">למוצר</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if shown_any -%}
          {%- if handles.size > 1 -%}
            {%- assign bundle_save = bundle_was | minus: bundle_now -%}
            <div class="nd-day__total">
              <span class="nd-day__total-label">
                {%- if day.kind == 'bundle' -%}השגרה המלאה{%- else -%}שלושתם יחד{%- endif -%}
              </span>
              <span class="nd-day__total-now">{% render 'nova-money', cents: bundle_now, symbol: '₪' %}</span>
              <s class="nd-day__total-was">{% render 'nova-money', cents: bundle_was, symbol: '₪' %}</s>
              <span class="nd-save">חיסכון {% render 'nova-money', cents: bundle_save, symbol: '₪' %}</span>
            </div>
          {%- endif -%}
          <p class="nd-terms">המחיר מתעדכן אוטומטית בסל. המבצע בתוקף היום בלבד, עד חצות.</p>
        {%- else -%}
          <p class="nd-terms">המבצע של היום אזל במלאי. המבצע השבועי עדיין פעיל.</p>
        {%- endif -%}
      </article>
    {%- endif -%}

    {%- comment -%} Tomorrow and the day after, the reason to come back. {%- endcomment -%}
    {%- assign shown = 0 -%}
    {%- assign upcoming = '' -%}
    {%- for d in cal.days offset: today_index -%}
      {%- unless forloop.first -%}
        {%- if shown < 2 -%}
          {%- if upcoming == '' -%}
            {%- assign upcoming = 'yes' -%}
          {%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}

    {%- if upcoming == 'yes' -%}
      <section class="nd-next">
        <h3 class="nd-next-head">מה בהמשך</h3>
        <ul class="nd-next-list">
          {%- assign shown = 0 -%}
          {%- for d in cal.days offset: today_index -%}
            {%- unless forloop.first -%}
              {%- if shown < 2 -%}
                <li class="nd-next-item">
                  <span class="nd-next-date">{{ d.date | date: '%d.%m' }}</span>
                  <span class="nd-next-what">
                    {%- if d.dark -%}
                      {{ d.dark_title | escape }}
                    {%- else -%}
                      {{ d.teaser | default: 'מבצע היום' | escape }}
                    {%- endif -%}
                  </span>
                </li>
                {%- assign shown = shown | plus: 1 -%}
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} The offer that runs all week, for anyone who missed today's. {%- endcomment -%}
  {%- assign wk = blank -%}
  {%- for w in cal.weeks -%}
    {%- if today >= w.from and today <= w.to -%}
      {%- assign wk = w -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if wk != blank -%}
    <section class="nd-week">
      <p class="nd-week-eyebrow">המבצע השבועי</p>
      <h3 class="nd-week-title">{{ wk.title | escape }}</h3>
      <p class="nd-week-body">{{ wk.body | escape }}</p>
      <p class="nd-week-dates">בתוקף {{ wk.from | date: '%d.%m' }} עד {{ wk.to | date: '%d.%m' }}</p>
      <a class="nd-btn nd-btn--ghost" href="{{ wk.url }}">{{ wk.cta | default: 'לאוסף' | escape }}</a>
    </section>
  {%- endif -%}

  {%- if cal.schedule_visible -%}
    <section class="nd-cal">
      <h3 class="nd-cal-head">לוח המבצעים</h3>
      <ul class="nd-cal-list">
        {%- for d in cal.days -%}
          <li class="nd-cal-row{% if d.date == today %} is-today{% endif %}{% if d.dark %} is-dark{% endif %}">
            <span class="nd-cal-date">{{ d.date | date: '%d.%m' }}</span>
            <span class="nd-cal-what">
              {%- if d.dark -%}{{ d.dark_title | escape }}{%- else -%}{{ d.teaser | escape }}{%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Nova deals",
  "settings": [],
  "presets": [{ "name": "Nova deals" }]
}
{% endschema %}
