{%- comment -%}
  nova-pdp.liquid

  ONE product page for the whole hair catalogue.

  The theme already carries five hand-built PDP sections (novahair-pdp-v2,
  hairloss-pdp, hairloss-pdp-staging, elasticdream-cro-pdp, ideo-skin-memory-pdp,
  ideo-v3-pdp) at 34-56KB each, one per product. That is why adding a product
  means rebuilding a page. This section is driven by product data, product
  metafields and theme-editor blocks instead, so a new product needs no new code.

  Block order follows the NovaHair sales page, which converts cold mobile social
  traffic at 4.03% while these product pages convert at 0.00%.

  Per-product content comes from the `nova` metafield namespace. Every field is
  optional and the section degrades cleanly when one is missing. Nothing here
  invents a rating, a review or a discount: prices come from the variants and
  proof renders only when the metafield holds a real value.
{%- endcomment -%}

{{ 'nova-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nova-pdp.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign p = product

  comment
    Which option is a pack ladder rather than a shade picker?
    Setting 0 means auto: an option qualifies when it has 2+ values and EVERY
    value carries a number, e.g. "1+1 / 2+2 / 3+3" or "בקבוק 1 / מארז 2".
    A shade list like "שחור / חום" has no numbers and stays a swatch picker,
    so one template serves the whole catalogue.
  endcomment

  assign ladder_index = -1
  if section.settings.ladder_option > 0
    assign ladder_index = section.settings.ladder_option | minus: 1
  else
    for option in p.options_with_values
      assign this_index = forloop.index0
      assign value_count = option.values.size
      assign numeric_count = 0
      for value in option.values
        assign words = value | replace: '+', ' ' | replace: '(', ' ' | replace: ')', ' ' | replace: 'x', ' ' | split: ' '
        assign found = 0
        for w in words
          assign n = w | times: 1
          if n > 0
            assign found = 1
            break
          endif
        endfor
        assign numeric_count = numeric_count | plus: found
      endfor
      if ladder_index < 0 and value_count > 1 and numeric_count == value_count
        assign ladder_index = this_index
      endif
    endfor
  endif

  assign sub = p.metafields.nova.subtitle.value
  assign chips = p.metafields.nova.chips.value
  assign rating = p.metafields.nova.rating.value
  assign rating_count = p.metafields.nova.rating_count.value
  assign form_id = 'nova-form-' | append: section.id

  comment
    Delivery window. Baymard's Consideration & Purchase study found 60% of users
    look for the return policy on the product page itself, and hiding delivery
    and shipping cost until checkout is one of the best documented causes of
    abandonment. These are calendar days from today and are labelled as an
    estimate, not a promise.
  endcomment
  assign today = 'now' | date: '%s' | plus: 0
  assign ship_from = section.settings.ship_min_days | times: 86400 | plus: today | date: '%-d.%-m'
  assign ship_to = section.settings.ship_max_days | times: 86400 | plus: today | date: '%-d.%-m'
-%}

<div class="nova-pdp" data-nova-pdp id="nova-pdp-{{ section.id }}">
  {%- if section.blocks.size > 0 -%}
    {%- assign trust_items = section.blocks | where: 'type', 'trust_item' -%}
    {%- if trust_items.size > 0 -%}
      <div class="nova-trustbar">
        {%- for b in trust_items -%}
          <span class="nova-trustbar__item" {{ b.shopify_attributes }}>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M8 1.5 14 4v4c0 3.2-2.4 5.6-6 6.5C4.4 13.6 2 11.2 2 8V4l6-2.5Z" />
              <path d="m5.5 8 1.8 1.8L10.8 6" />
            </svg>
            {{ b.settings.text }}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  <div class="nova-pdp__wrap">
    <div class="nova-pdp__top">
      {%- comment -%} ---------- MEDIA. First in DOM and first on mobile. ---------- {%- endcomment -%}
      <div class="nova-pdp__media">
        <div class="nova-gallery">
          {%- if section.settings.media_badge != blank -%}
            <span class="nova-gallery__badge">{{ section.settings.media_badge }}</span>
          {%- endif -%}

          <div class="nova-gallery__track" data-nova-track>
            {%- if p.media.size > 0 -%}
              {%- for media in p.media -%}
                {%- liquid
                  assign alt_text = media.alt | default: p.title
                  if forloop.first
                    assign ld = 'eager'
                  else
                    assign ld = 'lazy'
                  endif
                -%}
                <div class="nova-gallery__slide">
                  {{
                    media
                    | image_url: width: 1200
                    | image_tag:
                      loading: ld,
                      widths: '375, 550, 750, 1100, 1200',
                      sizes: '(min-width: 750px) 52vw, 100vw',
                      alt: alt_text
                  }}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="nova-gallery__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>

          {%- if p.media.size > 1 -%}
            <div class="nova-gallery__thumbs">
              {%- for media in p.media -%}
                <button
                  type="button"
                  class="nova-gallery__thumb"
                  data-nova-thumb
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="{{ section.settings.thumb_label }} {{ forloop.index }}"
                >
                  {{ media | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', alt: '' }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ---------- INFO ---------- {%- endcomment -%}
      <div class="nova-info">
        {%- comment -%}
          Proof renders only when the metafield actually holds a number.
          No placeholder rating, ever.
        {%- endcomment -%}
        {%- if rating != blank and rating > 0 -%}
          <div class="nova-rating">
            {%- assign full = rating | round -%}
            <span class="nova-rating__stars" aria-hidden="true">
              {%- for i in (1..5) -%}{% if i <= full %}★{% else %}☆{% endif %}{%- endfor -%}
            </span>
            <span>
              {{ rating }}
              {%- if rating_count != blank and rating_count > 0 %}
                · {{ rating_count }} {{ section.settings.rating_noun }}
              {%- endif -%}
            </span>
          </div>
        {%- endif -%}

        <h1 class="nova-title">{{ p.title | escape }}</h1>

        {%- if sub != blank -%}
          <p class="nova-sub">{{ sub }}</p>
        {%- endif -%}

        {%- liquid
          comment
            A crossed-out price and a "% off" badge are only honest if the
            compare-at price was genuinely charged at some point. Shopify cannot
            know that, so the owner confirms it per product with the
            nova.compare_at_verified metafield. Unset means no crossed-out price
            and no percentage, which is the safe default.
          endcomment
          assign v = p.selected_or_first_available_variant
          assign cap_ok = p.metafields.nova.compare_at_verified.value
          assign show_was = false
          if v.compare_at_price > v.price and cap_ok
            assign show_was = true
          endif
        -%}

        <div class="nova-price">
          <span class="nova-price__now" data-nova-price-now>{{ v.price | money }}</span>
          <s class="nova-price__was" data-nova-price-was {% unless show_was %}hidden{% endunless %}>
            {%- if show_was %}{{ v.compare_at_price | money }}{% endif -%}
          </s>
          <span class="nova-price__save" data-nova-price-save {% unless show_was %}hidden{% endunless %}>
            {%- if show_was -%}
              {%- assign pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round -%}
              {{ section.settings.save_prefix }} {{ pct }}%
            {%- endif -%}
          </span>
        </div>
        {%- if section.settings.price_note != blank -%}
          <p class="nova-price__note">{{ section.settings.price_note }}</p>
        {%- endif -%}

        {%- comment -%}
          Delivery and shipping-cost clarity, in the buy box rather than buried
          in a banner or left to checkout.
        {%- endcomment -%}
        {%- if section.settings.show_delivery and section.settings.ship_max_days > 0 -%}
          <p class="nova-deliver">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M1.8 5.2h9.4v8.3H1.8z" /><path d="M11.2 8h3.3l2.7 2.7v2.8h-6z" />
              <circle cx="5.6" cy="15.1" r="1.6" /><circle cx="14.1" cy="15.1" r="1.6" />
            </svg>
            <span>
              {{ section.settings.delivery_label }}
              <b>{{ ship_from }} {{ section.settings.delivery_to_word }} {{ ship_to }}</b>
              {%- if section.settings.free_ship_note != blank %} · {{ section.settings.free_ship_note }}{% endif -%}
            </span>
          </p>
        {%- endif -%}

        {%- if chips != blank -%}
          <ul class="nova-chips">
            {%- for c in chips -%}
              <li class="nova-chip">{{ c }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <form
          action="{{ routes.cart_add_url }}"
          method="post"
          enctype="multipart/form-data"
          id="{{ form_id }}"
          data-nova-form
        >
          <input type="hidden" name="id" value="{{ v.id }}" data-nova-variant-id>
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">

          {%- unless p.has_only_default_variant -%}
            {%- for option in p.options_with_values -%}
              {%- assign oi = forloop.index0 -%}

              {%- if oi == ladder_index -%}
                {%- comment -%} ---- pack ladder ---- {%- endcomment -%}
                {%- comment -%}
                  Baseline pass. The honest saving on a multi-pack is not the
                  gap to a compare-at price, it is what she would pay buying the
                  smallest pack over and over. That comparison uses only this
                  product's own real prices, so it is true by construction.
                {%- endcomment -%}
                {%- liquid
                  assign base_per = 0
                  assign base_units = 0
                  for value in option.values
                    assign clean = value | split: '(' | first
                    assign is_volume = false
                    if clean contains 'מ"ל' or clean contains 'מ״ל' or clean contains 'ml' or clean contains 'גרם'
                      assign is_volume = true
                    endif
                    assign has_bottle_noun = false
                    if clean contains 'בקבוק' or clean contains 'יחיד'
                      assign has_bottle_noun = true
                    endif
                    assign u = 0
                    unless is_volume
                      assign parts = clean | replace: '+', ' + ' | split: ' '
                      for w in parts
                        assign n = w | times: 1
                        if n > 0
                          if clean contains '+' and has_bottle_noun == false
                            assign u = u | plus: n
                          elsif u == 0
                            assign u = n
                          endif
                        endif
                      endfor
                    endunless
                    if u > 0
                      for cand in p.variants
                        if cand.options[oi] == value
                          assign cand_per = cand.price | divided_by: u
                          if base_units == 0 or u < base_units
                            assign base_units = u
                            assign base_per = cand_per
                          endif
                          break
                        endif
                      endfor
                    endif
                  endfor
                -%}
                <div class="nova-opt">
                  <div class="nova-opt__label">{{ option.name }}</div>
                  <div class="nova-packs">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign match = false
                        for cand in p.variants
                          if cand.options[oi] == value
                            assign match = cand
                            break
                          endif
                        endfor

                        comment
                          How many real units are in this pack?
                          Anything in brackets is a volume, not a count, so it is
                          dropped first: "מארז זוגי 1+1 (60 מ״ל)" is two bottles,
                          not sixty two. A value that only states a volume, like
                          "בקבוק 100 מ״ל", has no countable unit at all.
                          "2+2" is two paid plus two free, so the numbers are
                          summed to four. But when the value already names the
                          count itself, as in "3 בקבוקים 2+1 חינם", that stated
                          count wins and the promo maths is ignored: it is three
                          bottles, not six.
                        endcomment
                        assign clean = value | split: '(' | first
                        assign is_volume = false
                        if clean contains 'מ"ל' or clean contains 'מ״ל' or clean contains 'ml' or clean contains 'גרם'
                          assign is_volume = true
                        endif
                        assign has_bottle_noun = false
                        if clean contains 'בקבוק' or clean contains 'יחיד'
                          assign has_bottle_noun = true
                        endif
                        assign units = 0
                        unless is_volume
                          assign words = clean | replace: '+', ' + ' | split: ' '
                          for w in words
                            assign n = w | times: 1
                            if n > 0
                              if clean contains '+' and has_bottle_noun == false
                                assign units = units | plus: n
                              elsif units == 0
                                assign units = n
                              endif
                            endif
                          endfor
                        endunless

                        comment
                          True saving against buying the smallest pack repeatedly.
                        endcomment
                        assign true_pct = 0
                        if match and units > base_units and base_per > 0
                          assign would_pay = base_per | times: units
                          if would_pay > match.price
                            assign true_pct = would_pay | minus: match.price | times: 100.0 | divided_by: would_pay | round
                          endif
                        endif
                      -%}
                      <label class="nova-pack">
                        <input
                          type="radio"
                          name="nova-opt-{{ section.id }}-{{ oi }}"
                          value="{{ value | escape }}"
                          data-nova-option="{{ oi }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <span class="nova-pack__body">
                          <span class="nova-pack__main">
                            <span class="nova-pack__name">
                              {{ value }}
                              {%- comment -%}
                                The badge reports the true saving against this
                                product's own smallest pack, not a compare-at
                                price. Smaller number, but one that survives
                                a customer checking it.
                              {%- endcomment -%}
                              {%- if true_pct > 0 -%}
                                <span class="nova-pack__tag nova-pack__tag--save">{{ section.settings.save_prefix }} {{ true_pct }}%</span>
                              {%- endif -%}
                            </span>
                            {%- if match and units > 1 -%}
                              <span class="nova-pack__note">
                                {{ match.price | divided_by: units | money }} {{ section.settings.per_unit_label }}
                              </span>
                            {%- endif -%}
                          </span>
                          {%- if match -%}
                            <span class="nova-pack__price">
                              <span class="nova-pack__now">{{ match.price | money }}</span>
                              {%- if match.compare_at_price > match.price and cap_ok -%}
                                <s class="nova-pack__was">{{ match.compare_at_price | money }}</s>
                              {%- endif -%}
                            </span>
                          {%- endif -%}
                        </span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- else -%}
                {%- comment -%} ---- swatches when the option carries real swatch data, pills otherwise ---- {%- endcomment -%}
                {%- assign has_swatch = false -%}
                {%- for value in option.values -%}
                  {%- if value.swatch -%}{%- assign has_swatch = true -%}{%- break -%}{%- endif -%}
                {%- endfor -%}

                <div class="nova-opt">
                  <div class="nova-opt__label">
                    {{ option.name }}<span data-nova-selected-label="{{ oi }}">{{ option.selected_value }}</span>
                  </div>

                  {%- if has_swatch -%}
                    <div class="nova-swatches">
                      {%- for value in option.values -%}
                        <label class="nova-swatch">
                          <input
                            type="radio"
                            name="nova-opt-{{ section.id }}-{{ oi }}"
                            value="{{ value | escape }}"
                            data-nova-option="{{ oi }}"
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          <span class="visually-hidden">{{ value }}</span>
                          <span
                            class="nova-swatch__dot"
                            title="{{ value | escape }}"
                            {% if value.swatch.image %}
                              style="background-image:url({{ value.swatch.image | image_url: width: 96 }})"
                            {% elsif value.swatch.color %}
                              style="background-color:{{ value.swatch.color }}"
                            {% endif %}
                          ></span>
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <div class="nova-pills">
                      {%- for value in option.values -%}
                        <label class="nova-pill">
                          <input
                            type="radio"
                            name="nova-opt-{{ section.id }}-{{ oi }}"
                            value="{{ value | escape }}"
                            data-nova-option="{{ oi }}"
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          <span class="nova-pill__label">{{ value }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}

          {%- if section.settings.show_quantity and ladder_index < 0 -%}
            <div class="nova-opt">
              <div class="nova-opt__label">{{ section.settings.quantity_label }}</div>
              <div class="nova-pills">
                <button type="button" class="nova-pill__label" data-nova-qty-step="-1" aria-label="-">−</button>
                <input
                  class="nova-pill__label"
                  style="width:64px;text-align:center"
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  inputmode="numeric"
                  data-nova-qty
                >
                <button type="button" class="nova-pill__label" data-nova-qty-step="1" aria-label="+">+</button>
              </div>
            </div>
          {%- endif -%}

          {%- unless p.available -%}
            <p class="nova-soldout">{{ section.settings.soldout_note }}</p>
          {%- endunless -%}

          {%- comment -%}
            Honest low stock only. This reads the real tracked inventory of the
            selected variant and stays hidden unless it is genuinely at or below
            the threshold. It is not a countdown and there is no invented number:
            with CJ stock in the thousands this line simply never appears, which
            is the correct behaviour. Fake scarcity measurably costs more trust
            than it buys.
          {%- endcomment -%}
          <p class="nova-low" data-nova-low hidden></p>

          <button
            type="submit"
            name="add"
            class="nova-cta"
            data-nova-cta
            {% unless p.available %}disabled{% endunless %}
          >
            {%- if p.available -%}{{ section.settings.cta_text }}{%- else -%}{{ section.settings.soldout_text }}{%- endif -%}
          </button>
        </form>

        {%- assign reassure = section.blocks | where: 'type', 'reassurance' -%}
        {%- if reassure.size > 0 -%}
          <ul class="nova-reassure">
            {%- for b in reassure -%}
              <li {{ b.shopify_attributes }}>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="m3 8.4 3.2 3.2L13 5" />
                </svg>
                {{ b.settings.text }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%}
          Payment marks come from the shop's actually enabled payment types, so
          this can never advertise a method the checkout does not accept.
        {%- endcomment -%}
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="nova-pay" aria-label="{{ section.settings.payment_label }}">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'nova-pay__icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%} Direct links to the real policies, not a vague promise. {%- endcomment -%}
        {%- capture policy_links -%}
          {%- if shop.shipping_policy.body != blank -%}
            <a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>
          {%- endif -%}
          {%- if shop.refund_policy.body != blank -%}
            <a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>
          {%- endif -%}
        {%- endcapture -%}
        {%- if policy_links != blank -%}
          <p class="nova-policy">{{ policy_links }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%}
    ---------- ROUTINE ----------
    Per-product metafield wins over the template blocks, so a second product does
    not need a second template. Format per entry: "Title | Text".
  {%- endcomment -%}
  {%- assign mf_steps = p.metafields.nova.steps.value -%}
  {%- if mf_steps != blank -%}
    <section class="nova-sec nova-sec--sand">
      <div class="nova-pdp__wrap">
        {%- if section.settings.steps_eyebrow != blank -%}
          <p class="nova-sec__eyebrow">{{ section.settings.steps_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.steps_title != blank -%}
          <h2 class="nova-sec__title">{{ section.settings.steps_title }}</h2>
        {%- endif -%}
        <ol class="nova-steps">
          {%- for entry in mf_steps -%}
            {%- assign parts = entry | split: '|' -%}
            <li class="nova-step">
              <span class="nova-step__n">{{ forloop.index }}</span>
              <span>
                <span class="nova-step__t">{{ parts[0] | strip }}</span>
                {%- if parts.size > 1 -%}
                  <p class="nova-step__d">{{ parts[1] | strip }}</p>
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </section>
  {%- endif -%}

  {%- assign steps = section.blocks | where: 'type', 'step' -%}
  {%- if mf_steps == blank and steps.size > 0 -%}
    <section class="nova-sec nova-sec--sand">
      <div class="nova-pdp__wrap">
        {%- if section.settings.steps_eyebrow != blank -%}
          <p class="nova-sec__eyebrow">{{ section.settings.steps_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.steps_title != blank -%}
          <h2 class="nova-sec__title">{{ section.settings.steps_title }}</h2>
        {%- endif -%}
        <ol class="nova-steps">
          {%- for b in steps -%}
            <li class="nova-step" {{ b.shopify_attributes }}>
              <span class="nova-step__n">{{ forloop.index }}</span>
              <span>
                <span class="nova-step__t">{{ b.settings.title }}</span>
                <p class="nova-step__d">{{ b.settings.text }}</p>
              </span>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- DETAILS + FAQ ---------- {%- endcomment -%}
  {%- assign rows = section.blocks | where: 'type', 'accordion' -%}
  {%- assign mf_faq = p.metafields.nova.faq.value -%}
  {%- if p.description != blank or rows.size > 0 or mf_faq != blank -%}
    <section class="nova-sec">
      <div class="nova-pdp__wrap">
        {%- if section.settings.details_title != blank -%}
          <h2 class="nova-sec__title">{{ section.settings.details_title }}</h2>
        {%- endif -%}
        <div class="nova-acc">
          {%- if p.description != blank -%}
            <details class="nova-acc__item" open>
              <summary>{{ section.settings.description_label }}</summary>
              <div class="nova-acc__body rte">{{ p.description }}</div>
            </details>
          {%- endif -%}
          {%- comment -%} Per-product FAQ, format per entry: "Question | Answer". {%- endcomment -%}
          {%- if mf_faq != blank -%}
            {%- for entry in mf_faq -%}
              {%- assign parts = entry | split: '|' -%}
              <details class="nova-acc__item">
                <summary>{{ parts[0] | strip }}</summary>
                {%- if parts.size > 1 -%}
                  <div class="nova-acc__body rte">{{ parts[1] | strip }}</div>
                {%- endif -%}
              </details>
            {%- endfor -%}
          {%- endif -%}

          {%- for b in rows -%}
            <details class="nova-acc__item" {{ b.shopify_attributes }}>
              <summary>{{ b.settings.question }}</summary>
              <div class="nova-acc__body rte">{{ b.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- STICKY BUY BAR ---------- {%- endcomment -%}
  <div class="nova-sticky" data-nova-sticky>
    <span class="nova-sticky__price">
      <span class="nova-sticky__now" data-nova-sticky-now>{{ v.price | money }}</span>
      <s class="nova-sticky__was" data-nova-sticky-was {% unless show_was %}hidden{% endunless %}>
        {%- if show_was %}{{ v.compare_at_price | money }}{% endif -%}
      </s>
    </span>
    <button
      type="submit"
      form="{{ form_id }}"
      name="add"
      class="nova-cta"
      data-nova-sticky-cta
      {% unless p.available %}disabled{% endunless %}
    >
      {%- if p.available -%}{{ section.settings.cta_text }}{%- else -%}{{ section.settings.soldout_text }}{%- endif -%}
    </button>
  </div>

  {%- comment -%}
    Money strings are rendered here by Liquid so the JS never formats currency.
  {%- endcomment -%}
  <script type="application/json" data-nova-variants>
    {
      "strings": {
        "add": {{ section.settings.cta_text | json }},
        "soldout": {{ section.settings.soldout_text | json }},
        "unavailable": {{ section.settings.unavailable_text | json }}
      },
      "variants": [
        {%- for var in p.variants -%}
          {
            "id": {{ var.id }},
            "title": {{ var.title | json }},
            "options": {{ var.options | json }},
            "available": {{ var.available }},
            "url": {{ var.url | json }},
            "price": {{ var.price | money | strip_html | json }},
            "compare_at": {% if var.compare_at_price > var.price and cap_ok %}{{ var.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},
            "save_badge": {% if var.compare_at_price > var.price and cap_ok %}{% assign vp = var.compare_at_price | minus: var.price | times: 100.0 | divided_by: var.compare_at_price | round %}{{ section.settings.save_prefix | append: ' ' | append: vp | append: '%' | json }}{% else %}null{% endif %},
            "media_index": {% if var.featured_media %}{{ var.featured_media.position | minus: 1 }}{% else %}null{% endif %},
            "low_stock": {% if var.inventory_management != blank and var.inventory_policy == 'deny' and var.inventory_quantity > 0 and var.inventory_quantity <= section.settings.low_stock_threshold %}{{ section.settings.low_stock_text | replace: '[n]', var.inventory_quantity | json }}{% else %}null{% endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
</div>

